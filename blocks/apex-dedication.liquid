{% doc %}
  The LH dedication mark in the footer (Figma "LH Dedication Logo"). Links to the hidden
  dedication page.
{% enddoc %}
{%- assign mark_link = block.settings.link | default: '/pages/dedication' -%}
<a
  class="apex-dedication"
  href="{{ mark_link }}"
  style="--apex-dedication-color: {{ block.settings.color }};"
  {{ block.shopify_attributes }}
>
  <span class="svg-wrapper">{{ 'apex-dedication-mark.svg' | inline_asset_content }}</span>
  <span class="visually-hidden">{{ block.settings.label | escape }}</span>
</a>

{% schema %}
{
  "name": "LH dedication mark",
  "tag": null,
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave blank to link to /pages/dedication."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Screen reader label",
      "default": "Dedication"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Colour",
      "default": "#EADDC6"
    }
  ],
  "presets": [
    {
      "name": "LH dedication mark"
    }
  ]
}
{% endschema %}
