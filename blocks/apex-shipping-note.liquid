{% comment %}
  APEX shipping note (Figma product page "Shipping note"): a stone card with a truck icon, where we
  currently ship to, and dispatch / free shipping details. Text comes from the block settings; a
  product's own custom.shipping_note (multi-line text) replaces the second line.
{% endcomment %}
{%- assign detail = closest.product.metafields.custom.shipping_note.value | default: block.settings.detail -%}
<div class="apex-shipping-note" {{ block.shopify_attributes }}>
  <span class="apex-shipping-note__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h11v9H2zM13 9h4l4 4v2h-8z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  </span>
  <div>
    {%- if block.settings.heading != blank -%}
      <p class="apex-shipping-note__heading">{{ block.settings.heading | escape }}</p>
    {%- endif -%}
    {%- if detail != blank -%}
      <p class="apex-shipping-note__detail">{{ detail | escape | newline_to_br }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-shipping-note {
    display: flex;
    gap: 12px;
    padding: 20px 24px;
    border-radius: var(--apex-radius-md);
    background: var(--apex-stone-100);
    color: var(--apex-burrow);
  }

  .apex-shipping-note__icon {
    flex: none;
    display: flex;
    width: 24px;
    height: 24px;
  }

  .apex-shipping-note__heading {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-shipping-note__detail {
    margin: 6px 0 0;
    font-size: 0.875rem;
    line-height: 1.375rem;
    color: var(--apex-dried-moss);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APEX shipping note",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Currently shipping to QLD, NSW, ACT and VIC" },
    { "type": "textarea", "id": "detail", "label": "Detail", "default": "Dispatched in 1 to 2 business days. Free shipping on orders over $150.", "info": "A product's own custom.shipping_note metafield replaces this." }
  ],
  "presets": [{ "name": "APEX shipping note" }]
}
{% endschema %}
