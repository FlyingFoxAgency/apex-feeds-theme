{% comment %}
  APEX collection header (Figma "APEX Category Page" > Category Header): a full-width panel that
  fades from clear on the left to burrow on the right, with an eyebrow, the collection name in
  large Dharma, its description, and an image on the right (the snowflakes on Frozen Meals).

  Per collection, the title, eyebrow and image can come from collection metafields:
  custom.header_title (single line text), custom.eyebrow (single line text) and
  custom.header_art (file, image), plus the panel colours custom.header_color and
  custom.header_color_middle (colour), and the image's width, distance from the top and
  distance from the right in px: custom.header_art_width, custom.header_art_top,
  custom.header_art_right (integers). Without them the section settings are used.

  Title order: the collection's custom.header_title, then the name of the matching item in the
  shop menu, then the collection's own title.
{% endcomment %}
{%- liquid
  assign eyebrow = collection.metafields.custom.eyebrow.value | default: section.settings.eyebrow
  assign art = collection.metafields.custom.header_art.value | default: section.settings.decoration
  assign panel_from = collection.metafields.custom.header_color.value | default: section.settings.gradient_from
  assign panel_to = collection.metafields.custom.header_color_middle.value | default: section.settings.gradient_to
  assign art_w = collection.metafields.custom.header_art_width.value | default: section.settings.art_width
  assign art_top = collection.metafields.custom.header_art_top.value | default: section.settings.art_top
  assign art_right = collection.metafields.custom.header_art_right.value
  if art_right == blank
    assign art_right = section.settings.art_right
  endif
  assign title = collection.title | default: section.settings.fallback_title
  if request.page_type == 'search' or collection.handle == 'all'
    assign title = section.settings.fallback_title
  endif

  assign menu = section.settings.menu | default: linklists.shop
  if collection
    for link in menu.links
      if link.url == collection.url
        assign title = link.title
        break
      endif
      for child in link.links
        if child.url == collection.url
          assign title = child.title
        endif
      endfor
    endfor
  endif

  assign title_override = collection.metafields.custom.header_title.value
  if title_override != blank
    assign title = title_override
  endif
-%}
<div
  class="apex-collection-header"
  style="--apex-collection-from: {{ panel_from }}; --apex-collection-to: {{ panel_to }}; --apex-art-w: {{ art_w }}; --apex-art-top: {{ art_top }}; --apex-art-right: {{ art_right }};"
>
  <div class="apex-container apex-collection-header__inner">
    <div class="apex-collection-header__content">
      {%- if eyebrow != blank -%}
        <p class="apex-eyebrow apex-collection-header__eyebrow">{{ eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="apex-collection-header__title">{{ title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="apex-collection-header__text">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if art != blank -%}
      <div class="apex-collection-header__art" aria-hidden="true">
        {{ art | image_url: width: 1000 | image_tag: loading: 'eager', alt: '', sizes: '(min-width: 990px) 463px, 50vw' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-collection-header {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-block-start: 53px;
    background: linear-gradient(
      270deg,
      var(--apex-collection-from) 0%,
      var(--apex-collection-from) 31%,
      var(--apex-collection-to) 53%,
      transparent 100%
    );
  }

  .apex-collection-header__inner {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-height: 461px;
  }

  /* Figma: eyebrow 30px from the top, 51px in from the grid; text 578px wide */
  .apex-collection-header__content {
    position: relative;
    z-index: 1;
    max-width: calc(578px + 51px);
    padding: 30px 0 43px 51px;
  }

  .apex-collection-header__eyebrow {
    margin: 0;
  }

  /* Dharma 128/102 with Figma's soft drop shadow */
  .apex-collection-header__title {
    margin: 35px 0 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(4rem, 8.9vw, 8rem);
    line-height: 0.8;
    text-transform: uppercase;
    color: var(--apex-burrow);
    text-shadow: 0 4px 4.3px rgb(0 0 0 / 0.25);
  }

  .apex-collection-header__text {
    max-width: 520px;
    margin-block-start: 35px;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.5rem;
    color: var(--apex-burrow);
  }

  .apex-collection-header__text > :first-child {
    margin-block-start: 0;
  }

  .apex-collection-header__text > :last-child {
    margin-block-end: 0;
  }

  /* Image at the top right (Figma: 463 x 388, 46px from the top). Width and position come from
     the section settings; the width scales down with the screen below 1440px. */
  .apex-collection-header__art {
    position: absolute;
    inset-block-start: calc(var(--apex-art-top, 46) * 1px);
    inset-inline-end: calc(var(--apex-art-right, 20) * 1px);
    width: min(calc(var(--apex-art-w, 463) * 1px), calc(var(--apex-art-w, 463) * 100vw / 1440));
    pointer-events: none;
  }

  .apex-collection-header__art img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .apex-collection-header {
      margin-block-start: var(--apex-space-32);
      background: linear-gradient(
        270deg,
        var(--apex-collection-from) 0%,
        var(--apex-collection-to) 55%,
        transparent 100%
      );
    }

    .apex-collection-header__inner {
      min-height: 0;
    }

    .apex-collection-header__content {
      padding: var(--apex-space-32) 0;
    }

    .apex-collection-header__title {
      margin: var(--apex-space-24) 0 0;
    }

    .apex-collection-header__text {
      margin-block-start: var(--apex-space-24);
      max-width: 54ch;
    }

    .apex-collection-header__art {
      inset-block-start: calc(var(--apex-art-top, 46) * 0.5px);
      inset-inline-end: calc(var(--apex-art-right, 20) * 0.5px - var(--page-margin, 16px));
      width: calc(var(--apex-art-w, 463) * 40vw / 463);
      opacity: 0.6;
    }
  }
  /* Phones: image at 40%, smaller description in 80% of the screen width */
  @media screen and (max-width: 749px) {
    .apex-collection-header__art {
      opacity: 0.4;
    }

    .apex-collection-header__text {
      max-width: 80vw;
      font-size: 0.8125rem;
      line-height: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APEX collection header",
  "tag": "section",
  "class": "apex-collection-header-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium animal supplements",
      "info": "A collection's own custom.eyebrow metafield replaces this."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the collection description",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu for category titles",
      "info": "The title uses this menu's name for the collection (the Shop menu if left empty). A collection's own custom.header_title metafield replaces it."
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Title when there's no collection",
      "default": "Shop all"
    },
    {
      "type": "image_picker",
      "id": "decoration",
      "label": "Header image on the right",
      "info": "Line art or any graphic, ideally a transparent PNG (the snowflakes are 463 x 388). A collection's own custom.header_art metafield replaces this."
    },
    {
      "type": "range",
      "id": "art_width",
      "label": "Image width",
      "min": 100,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 460,
      "info": "Width on a full-size desktop screen; it scales down on smaller screens. Anything outside the panel is cropped. A collection's own custom.header_art_width, custom.header_art_top and custom.header_art_right metafields replace these three sliders."
    },
    {
      "type": "range",
      "id": "art_top",
      "label": "Image distance from the top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "art_right",
      "label": "Image distance from the right",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 20,
      "info": "Negative values push the image past the right edge of the panel."
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Panel colour (right)",
      "default": "#40443D",
      "info": "A collection's own custom.header_color metafield replaces this."
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Panel middle colour",
      "default": "#A0AA98",
      "info": "Fades to clear on the left. A collection's own custom.header_color_middle metafield replaces this."
    }
  ],
  "presets": [
    {
      "name": "APEX collection header"
    }
  ]
}
{% endschema %}
