{% comment %}
  APEX product carousel (Figma "Best Sellers"): a section title with round arrow buttons on the
  right, and a sliding row of APEX product cards from one collection. Optional line art (the
  lizard) sits behind the top left.
{% endcomment %}
<script src="{{ 'apex-home.js' | asset_url }}" type="module"></script>

{%- liquid
  # On a category page, that category's own custom.cross_sell collection (if set) replaces the
  # section's collection, e.g. calcium and gut-loads under Frozen meals.
  assign page_collection = collection
  assign collection = section.settings.collection
  if page_collection.metafields.custom.cross_sell.value != blank
    assign collection = page_collection.metafields.custom.cross_sell.value
  endif

  assign title_link = section.settings.title_link
  if title_link == blank and collection != blank and template.name == 'collection'
    assign title_link = collection.url
  endif
-%}

<div class="apex-product-carousel{% if section.settings.band %} apex-product-carousel--band{% endif %}{% if section.settings.decoration_side == 'right' %} apex-product-carousel--art-right{% endif %}"
  {% if section.settings.indicator_label != blank %} data-apex-indicator-label="{{ section.settings.indicator_label | escape }}"{% endif %}
>
  {%- if section.settings.decoration != blank -%}
    <div class="apex-decoration apex-product-carousel__decoration" aria-hidden="true">
      {{ section.settings.decoration | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}

  <apex-carousel class="apex-product-carousel__inner apex-container">
    <div class="apex-product-carousel__header">
      {%- if section.settings.title != blank -%}
        <div class="apex-product-carousel__title">
          <h2 class="apex-section-title">{{ section.settings.title | escape }}</h2>
          {%- if title_link != blank -%}
            <a class="apex-product-carousel__title-link" href="{{ title_link }}" aria-label="See all: {{ section.settings.title | escape }}">
              {{- 'apex-icon-arrow.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="apex-product-carousel__arrows">
        <button type="button" class="apex-product-carousel__arrow apex-product-carousel__arrow--prev" data-prev aria-label="Previous products">
          {{- 'apex-icon-arrow-circle.svg' | inline_asset_content -}}
        </button>
        <button type="button" class="apex-product-carousel__arrow" data-next aria-label="Next products">
          {{- 'apex-icon-arrow-circle.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>

    <ul class="apex-product-carousel__track list-unstyled" data-track role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li class="apex-product-carousel__item">
            {%- render 'apex-product-card', product: product, show_buttons: section.settings.show_buttons -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="apex-product-carousel__item">
            <article class="apex-product-card">
              <div class="apex-product-card__link">
                <div class="apex-product-card__media">
                  {{ 'product-1' | placeholder_svg_tag: 'apex-product-card__placeholder' }}
                </div>
                <div class="apex-product-card__info">
                  <p class="apex-product-card__category">Category</p>
                  <div class="apex-product-card__row">
                    <h3 class="apex-product-card__title">Product title</h3>
                    <p class="apex-product-card__price">{{ 4999 | money }}</p>
                  </div>
                  <p class="apex-product-card__note">For reptiles + amphibians.</p>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </apex-carousel>
</div>

{% stylesheet %}
  .apex-product-carousel {
    position: relative;
    isolation: isolate;
    padding-block: var(--apex-space-96) var(--apex-space-96);
  }

  .apex-product-carousel__decoration {
    inset-block-start: 0;
    inset-inline-start: max(-203px, -14vw);
    width: min(556px, 38.6vw);
  }

  .apex-product-carousel__inner {
    position: relative;
    z-index: 1;
    display: block;
  }

  .apex-product-carousel__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--apex-space-24);
  }

  .apex-product-carousel__arrows {
    display: flex;
    gap: 7px;
  }

  .apex-product-carousel__arrow {
    display: flex;
    width: 41px;
    height: 41px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--apex-burrow);
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      scale 0.2s var(--ease-out-cubic, ease-out);
  }

  .apex-product-carousel__arrow svg {
    width: 41px;
    height: 41px;
  }

  .apex-product-carousel__arrow--prev svg {
    rotate: 180deg;
  }

  .apex-product-carousel__arrow:not(:disabled):is(:hover, :focus-visible) {
    scale: 1.06;
  }

  .apex-product-carousel__arrow:disabled {
    opacity: 0.24;
    cursor: default;
  }

  apex-carousel[data-static] .apex-product-carousel__arrows {
    visibility: hidden;
  }

  .apex-product-carousel__track {
    --apex-carousel-gap: 20px;
    --apex-carousel-visible: 4;

    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(
      (100% - (var(--apex-carousel-visible) - 1) * var(--apex-carousel-gap)) / var(--apex-carousel-visible)
    );
    gap: var(--apex-carousel-gap);
    margin: var(--apex-space-24) 0 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .apex-product-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .apex-product-carousel__item {
    scroll-snap-align: start;
  }

  /* Title with an optional arrow link after it (Figma "Customers also bought") */
  .apex-product-carousel__title {
    display: flex;
    align-items: center;
    gap: var(--apex-space-16);
    min-width: 0;
  }

  .apex-product-carousel__arrows {
    flex: none;
  }

  @media screen and (max-width: 749px) {
    .apex-product-carousel__title-link svg {
      width: 32px;
      height: 32px;
    }
  }

  .apex-product-carousel__title-link {
    display: flex;
    color: var(--apex-burrow);
    transition: scale 0.2s var(--ease-out-cubic, ease-out);
  }

  .apex-product-carousel__title-link svg {
    width: 46px;
    height: 46px;
  }

  .apex-product-carousel__title-link:is(:hover, :focus-visible) {
    scale: 1.06;
  }

  /* Band behind the cards (Figma: #CFCFCA fading to dried moss, from just under the title to
     32px below the cards) */
  .apex-product-carousel--band {
    margin-block-end: 120px;
    padding-block: 0;
    overflow-x: clip;
  }

  /* The band shares the track's grid row, so it always starts just under the title however
     many lines it wraps to, and runs to both screen edges */
  .apex-product-carousel--band .apex-product-carousel__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .apex-product-carousel--band .apex-product-carousel__inner::before {
    content: '';
    z-index: -1;
    grid-area: 2 / 1;
    margin-block-start: -7px;
    margin-inline: calc((100% - 100vw) / 2);
    background: linear-gradient(180deg, #cfcfca 0%, var(--apex-dried-moss) 100%);
  }

  .apex-product-carousel--band .apex-product-carousel__track {
    grid-area: 2 / 1;
  }

  .apex-product-carousel--band .apex-product-carousel__track {
    margin-block-start: 32px;
    padding-block: 0 32px;
  }

  /* Cards grow on hover, so leave them room inside the scroller */
  .apex-product-carousel--band .apex-product-carousel__track:has(.apex-product-card--buttons) {
    padding-block-start: 10px;
    margin-block-start: 22px;
  }

  .apex-product-carousel--art-right .apex-product-carousel__decoration {
    inset-inline: auto max(16px, calc((100vw - 1440px) / 2 + 58px));
    inset-block-start: -83px;
    width: min(346px, 30vw);
  }

  @media screen and (max-width: 989px) {
    .apex-product-carousel__track {
      --apex-carousel-visible: 2.3;
    }
  }

  @media screen and (max-width: 749px) {
    /* 72px from the Shop by animals buttons above (Ell), with their 4px margin */
    .apex-product-carousel {
      padding-block: 68px var(--apex-space-64);
    }

    /* The row runs to both screen edges and cards that aren't fully on screen are faded,
       like the other sliders */
    .apex-product-carousel__track {
      --apex-carousel-visible: 1.3;
      --apex-carousel-gap: 16px;
      --apex-carousel-bleed: calc((100vw - 100%) / 2);

      margin-inline: calc(-1 * var(--apex-carousel-bleed));
      padding-inline: var(--apex-carousel-bleed);
      /* In px: a % here would measure the scroller, not the section */
      scroll-padding-inline: var(--page-margin, 16px);
      overscroll-behavior-x: contain;
    }

    .apex-product-carousel__item {
      transition: opacity 0.4s ease;
    }

    apex-carousel[data-ready] .apex-product-carousel__item:not(.is-current) {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-product-carousel__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APEX product carousel",
  "tag": "section",
  "class": "apex-product-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "indicator_label",
      "label": "Name in the page indicator",
      "default": "Best sellers",
      "info": "Shown next to this section's dot on the left. Leave blank to leave it out."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Best sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "On category pages, a collection's own custom.cross_sell metafield (collection reference) replaces this."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "url",
      "id": "title_link",
      "label": "Arrow link after the title",
      "info": "Leave blank for no arrow (on category pages it then links to the collection shown)."
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show Add to cart on the cards",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Colour band behind the cards",
      "default": false,
      "info": "The soft grey to moss band from the category page."
    },
    {
      "type": "image_picker",
      "id": "decoration",
      "label": "Line art",
      "info": "Transparent PNG (the lizard in Figma \"Best Sellers\", 556 x 360)."
    },
    {
      "type": "select",
      "id": "decoration_side",
      "label": "Line art position",
      "options": [
        { "value": "left", "label": "Behind the top left" },
        { "value": "right", "label": "Above the top right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "APEX product carousel"
    }
  ]
}
{% endschema %}
