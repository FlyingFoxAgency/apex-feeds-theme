{% comment %}
  APEX product carousel (Figma "Best Sellers"): a section title with round arrow buttons on the
  right, and a sliding row of APEX product cards from one collection. Optional line art (the
  lizard) sits behind the top left.
{% endcomment %}
<script src="{{ 'apex-home.js' | asset_url }}" type="module"></script>
{%- if section.settings.source == 'recommendations' -%}
  <script src="{{ 'apex-product.js' | asset_url }}" type="module"></script>
{%- endif -%}

{%- liquid
  # On a category page, that category's own custom.cross_sell collection (if set) replaces the
  # section's collection, e.g. calcium and gut-loads under Frozen meals.
  assign page_collection = collection
  assign collection = section.settings.collection
  if page_collection.metafields.custom.cross_sell.value != blank
    assign collection = page_collection.metafields.custom.cross_sell.value
  endif

  # Product pages: Shopify's recommendations for this product, fetched after load (see
  # assets/apex-product.js). Until they arrive, or when there are none, the product's own
  # category collection shows (or the section's collection).
  assign use_recommendations = false
  if section.settings.source == 'recommendations' and product != blank
    assign use_recommendations = true
    if collection == blank
      assign category_handle = product.metafields.custom.shop_category.value | default: product.metafields.custom.shop_nav_category.value
      if category_handle.first != blank
        assign category_handle = category_handle.first
      endif
      assign category_handle = category_handle | handleize
      if category_handle == 'ancilleries'
        assign category_handle = 'ancillaries'
      endif
      assign collection = collections[category_handle] | default: product.collections.first
    endif

    # A category that only holds this product would leave an empty row: use the whole shop
    assign others = 0
    for item in collection.products limit: 2
      if item.id != product.id
        assign others = others | plus: 1
      endif
    endfor
    if others == 0
      assign collection = collections.all
    endif
  endif

  assign title_link = section.settings.title_link
  if title_link == blank and collection != blank and template.name == 'collection'
    assign title_link = collection.url
  endif
-%}

<div class="apex-product-carousel{% if section.settings.band %} apex-product-carousel--band{% endif %}{% if section.settings.decoration_side == 'right' %} apex-product-carousel--art-right{% endif %}"
  {% if section.settings.indicator_label != blank %} data-apex-indicator-label="{{ section.settings.indicator_label | escape }}"{% endif %}
>
  {%- if section.settings.decoration != blank -%}
    {%- capture art_style -%}
      {%- if section.settings.decoration_custom -%}
        --apex-art-width: {{ section.settings.decoration_width }}px; --apex-art-top: {{ section.settings.decoration_top }}px; --apex-art-side: {{ section.settings.decoration_side_offset }}px;
      {%- endif -%}
    {%- endcapture -%}
    <div class="apex-decoration apex-product-carousel__decoration{% if section.settings.decoration_custom %} apex-product-carousel__decoration--custom{% endif %}{% if section.settings.decoration_front %} apex-product-carousel__decoration--front{% endif %}" aria-hidden="true"{% if art_style != blank %} style="{{ art_style | strip }}"{% endif %}>
      {{ section.settings.decoration | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}

  <apex-carousel class="apex-product-carousel__inner apex-container">
    <div class="apex-product-carousel__header">
      {%- if section.settings.title != blank -%}
        <div class="apex-product-carousel__title">
          <h2 class="apex-section-title">{{ section.settings.title | escape }}</h2>
          {%- if title_link != blank -%}
            <a class="apex-product-carousel__title-link" href="{{ title_link }}" aria-label="See all: {{ section.settings.title | escape }}">
              {{- 'apex-icon-arrow.svg' | inline_asset_content -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="apex-product-carousel__arrows">
        <button type="button" class="apex-product-carousel__arrow apex-product-carousel__arrow--prev" data-prev aria-label="Previous products">
          {{- 'apex-icon-arrow-circle.svg' | inline_asset_content -}}
        </button>
        <button type="button" class="apex-product-carousel__arrow" data-next aria-label="Next products">
          {{- 'apex-icon-arrow-circle.svg' | inline_asset_content -}}
        </button>
      </div>
    </div>

    {%- if use_recommendations -%}
      <apex-recommendations
        class="apex-product-carousel__recommendations"
        data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&section_id={{ section.id }}&intent=related"
      >
    {%- endif -%}
    <ul class="apex-product-carousel__track list-unstyled" data-track role="list"{% if recommendations.performed? %} data-recommended{% endif %}>
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        {%- for item in recommendations.products -%}
          <li class="apex-product-carousel__item">
            {%- render 'apex-product-card', product: item, show_buttons: section.settings.show_buttons -%}
          </li>
        {%- endfor -%}
      {%- elsif collection != blank and collection.products_count > 0 -%}
        {%- assign shown = 0 -%}
        {%- for item in collection.products -%}
          {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= section.settings.products_to_show -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="apex-product-carousel__item">
            {%- render 'apex-product-card', product: item, show_buttons: section.settings.show_buttons -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="apex-product-carousel__item">
            <article class="apex-product-card">
              <div class="apex-product-card__link">
                <div class="apex-product-card__media">
                  {{ 'product-1' | placeholder_svg_tag: 'apex-product-card__placeholder' }}
                </div>
                <div class="apex-product-card__info">
                  <p class="apex-product-card__category">Category</p>
                  <div class="apex-product-card__row">
                    <h3 class="apex-product-card__title">Product title</h3>
                    <p class="apex-product-card__price">{{ 4999 | money }}</p>
                  </div>
                  <p class="apex-product-card__note">For reptiles + amphibians.</p>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if use_recommendations -%}
      </apex-recommendations>
    {%- endif -%}
  </apex-carousel>
</div>

{% stylesheet %}
  .apex-product-carousel__recommendations {
    display: contents;
  }

  .apex-product-carousel {
    position: relative;
    isolation: isolate;
    padding-block: var(--apex-space-96) var(--apex-space-96);
  }

  .apex-product-carousel__decoration {
    inset-block-start: 0;
    inset-inline-start: max(-203px, -14vw);
    width: min(556px, 38.6vw);
  }

  .apex-product-carousel__inner {
    position: relative;
    z-index: 1;
    display: block;
  }

  .apex-product-carousel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--apex-space-24);
  }

  .apex-product-carousel__arrows {
    display: flex;
    gap: 7px;
  }

  .apex-product-carousel__arrow {
    display: flex;
    width: 41px;
    height: 41px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--apex-burrow);
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      scale 0.2s var(--ease-out-cubic, ease-out);
  }

  .apex-product-carousel__arrow svg {
    width: 41px;
    height: 41px;
  }

  .apex-product-carousel__arrow--prev svg {
    rotate: 180deg;
  }

  .apex-product-carousel__arrow:not(:disabled):is(:hover, :focus-visible) {
    scale: 1.06;
  }

  .apex-product-carousel__arrow:disabled {
    opacity: 0.24;
    cursor: default;
  }

  apex-carousel[data-static] .apex-product-carousel__arrows {
    visibility: hidden;
  }

  .apex-product-carousel__track {
    --apex-carousel-gap: 20px;
    --apex-carousel-visible: 4;

    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(
      (100% - (var(--apex-carousel-visible) - 1) * var(--apex-carousel-gap)) / var(--apex-carousel-visible)
    );
    gap: var(--apex-carousel-gap);
    margin: var(--apex-space-24) 0 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .apex-product-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .apex-product-carousel__item {
    scroll-snap-align: start;
  }

  /* Title with an optional arrow link after it (Figma "Customers also bought") */
  .apex-product-carousel__title {
    display: flex;
    align-items: center;
    gap: var(--apex-space-16);
    min-width: 0;
  }

  .apex-product-carousel__arrows {
    flex: none;
  }

  @media screen and (max-width: 749px) {
    .apex-product-carousel__title-link svg {
      width: 32px;
      height: 32px;
    }
  }

  .apex-product-carousel__title-link {
    display: flex;
    color: var(--apex-burrow);
    transition: scale 0.2s var(--ease-out-cubic, ease-out);
  }

  .apex-product-carousel__title-link svg {
    width: 46px;
    height: 46px;
  }

  .apex-product-carousel__title-link:is(:hover, :focus-visible) {
    scale: 1.06;
  }

  /* Band behind the cards (Figma: #CFCFCA fading to dried moss, from just under the title to
     32px below the cards) */
  .apex-product-carousel--band {
    margin-block-end: 120px;
    padding-block: 0;
    overflow-x: clip;
  }

  /* The band shares the track's grid row, so it always starts just under the title however
     many lines it wraps to, and runs to both screen edges */
  .apex-product-carousel--band .apex-product-carousel__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .apex-product-carousel--band .apex-product-carousel__inner::before {
    content: '';
    z-index: -1;
    grid-area: 2 / 1;
    margin-block-start: -7px;
    margin-inline: calc((100% - 100vw) / 2);
    background: linear-gradient(180deg, #cfcfca 0%, var(--apex-dried-moss) 100%);
  }

  /* Cards on the band match the cards on the page above instead of tinting the band through */
  .apex-product-carousel--band .apex-product-card {
    background-color: var(--apex-glass-solid);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .apex-product-carousel--band .apex-product-carousel__track {
    grid-area: 2 / 1;
  }

  .apex-product-carousel--band .apex-product-carousel__track {
    margin-block-start: 32px;
    padding-block: 0 32px;
  }

  /* Cards grow on hover, so leave them room inside the scroller */
  .apex-product-carousel--band .apex-product-carousel__track:has(.apex-product-card--buttons) {
    padding-block-start: 10px;
    margin-block-start: 22px;
  }

  .apex-product-carousel--art-right .apex-product-carousel__decoration {
    inset-inline: auto max(16px, calc((100vw - 1440px) / 2 + 58px));
    inset-block-start: -83px;
    width: min(346px, 30vw);
  }

  /* Line art with its own size and position (section settings) */
  .apex-product-carousel__decoration--custom,
  .apex-product-carousel--art-right .apex-product-carousel__decoration--custom {
    inset-block-start: var(--apex-art-top);
    inset-inline-start: var(--apex-art-side);
    inset-inline-end: auto;
    width: var(--apex-art-width);
  }

  .apex-product-carousel--art-right .apex-product-carousel__decoration--custom {
    inset-inline-start: auto;
    inset-inline-end: var(--apex-art-side);
  }

  /* In front of the band and the arrows instead of tucked behind them */
  .apex-product-carousel__decoration--front {
    z-index: 2;
  }

  @media screen and (max-width: 989px) {
    .apex-product-carousel__track {
      --apex-carousel-visible: 2.3;
    }
  }

  @media screen and (max-width: 749px) {
    /* 72px from the Shop by animals buttons above (Ell), with their 4px margin */
    .apex-product-carousel {
      padding-block: 68px var(--apex-space-64);
    }

    /* The row runs to both screen edges and cards that aren't fully on screen are faded,
       like the other sliders */
    .apex-product-carousel__track {
      --apex-carousel-visible: 1.3;
      --apex-carousel-gap: 16px;
      --apex-carousel-bleed: calc((100vw - 100%) / 2);

      margin-inline: calc(-1 * var(--apex-carousel-bleed));
      padding-inline: var(--apex-carousel-bleed);
      /* In px: a % here would measure the scroller, not the section */
      scroll-padding-inline: var(--page-margin, 16px);
      overscroll-behavior-x: contain;
    }

    .apex-product-carousel__item {
      transition: opacity 0.4s ease;
    }

    apex-carousel[data-ready] .apex-product-carousel__item:not(.is-current) {
      opacity: 0.5;
    }

    /* The arrows are taller than the phone title, so the band starts right under them instead of
       tucking up behind the header */
    .apex-product-carousel--band .apex-product-carousel__inner::before {
      margin-block-start: 0;
    }

    /* Right-hand line art (the gecko) 1.5x bigger, growing down from where it starts */
    .apex-product-carousel--art-right .apex-product-carousel__decoration {
      width: 45vw;
    }

    /* Custom-sized line art scales down with the phone screen */
    .apex-product-carousel__decoration--custom,
    .apex-product-carousel--art-right .apex-product-carousel__decoration--custom {
      width: calc(var(--apex-art-width) * 0.5);
      inset-block-start: calc(var(--apex-art-top) * 0.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-product-carousel__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APEX product carousel",
  "tag": "section",
  "class": "apex-product-carousel-section",
  "settings": [
    {
      "type": "text",
      "id": "indicator_label",
      "label": "Name in the page indicator",
      "default": "Best sellers",
      "info": "Shown next to this section's dot on the left. Leave blank to leave it out."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Best sellers"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "options": [
        { "value": "collection", "label": "From a collection" },
        { "value": "recommendations", "label": "Recommended for this product" }
      ],
      "default": "collection",
      "info": "Recommended for this product only works on product pages. Until Shopify has learned what sells together, the product's own category (or the collection below) shows."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "On category pages, a collection's own custom.cross_sell metafield (collection reference) replaces this."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "url",
      "id": "title_link",
      "label": "Arrow link after the title",
      "info": "Leave blank for no arrow (on category pages it then links to the collection shown)."
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show Add to cart on the cards",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Colour band behind the cards",
      "default": false,
      "info": "The soft grey to moss band from the category page."
    },
    {
      "type": "image_picker",
      "id": "decoration",
      "label": "Line art",
      "info": "Transparent PNG (the lizard in Figma \"Best Sellers\", 556 x 360)."
    },
    {
      "type": "select",
      "id": "decoration_side",
      "label": "Line art position",
      "options": [
        { "value": "left", "label": "Behind the top left" },
        { "value": "right", "label": "Above the top right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "decoration_front",
      "label": "Line art in front of the band",
      "info": "Off: the band and cards cover the bottom of the line art.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "decoration_custom",
      "label": "Set the line art size and position",
      "default": false
    },
    {
      "type": "range",
      "id": "decoration_width",
      "label": "Line art width",
      "min": 80,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 340,
      "visible_if": "{{ section.settings.decoration_custom }}"
    },
    {
      "type": "range",
      "id": "decoration_top",
      "label": "Line art top",
      "info": "Negative moves it up above the section. Phones use half.",
      "min": -400,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": -80,
      "visible_if": "{{ section.settings.decoration_custom }}"
    },
    {
      "type": "range",
      "id": "decoration_side_offset",
      "label": "Line art distance from the side",
      "min": -300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 60,
      "visible_if": "{{ section.settings.decoration_custom }}"
    }
  ],
  "presets": [
    {
      "name": "APEX product carousel"
    }
  ]
}
{% endschema %}
