{% comment %}
  APEX feature (Figma "Shop Premium"): a section title, then a full-width gradient panel with
  a large product image breaking out above and below it on the left, text and a dark button on
  the right, and optional line art (the snake) behind the top right.
{% endcomment %}
<div
  class="apex-feature"
  {% if section.settings.indicator_label != blank %} data-apex-indicator-label="{{ section.settings.indicator_label | escape }}"{% endif %}
  style="--apex-feature-from: {{ section.settings.gradient_from }}; --apex-feature-to: {{ section.settings.gradient_to }};"
>
  <div class="apex-feature__stage">
    {%- if section.settings.decoration != blank -%}
      <div class="apex-decoration apex-feature__decoration" aria-hidden="true">
        {{ section.settings.decoration | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <div class="apex-container">
        <h2 class="apex-section-title apex-feature__title">{{ section.settings.title | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="apex-feature__panel">
      {%- if section.settings.image != blank -%}
        <div class="apex-feature__media">
          {{
            section.settings.image
            | image_url: width: 2200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 78vw, 100vw',
              widths: '600, 900, 1200, 1600, 2200',
              alt: section.settings.image.alt
          }}
        </div>
      {%- elsif request.design_mode -%}
        <div class="apex-feature__media apex-feature__media--placeholder">
          {{ 'product-apparel-2' | placeholder_svg_tag }}
        </div>
      {%- endif -%}

      <div class="apex-feature__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="apex-eyebrow apex-feature__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h3 class="apex-feature__heading">{{ section.settings.heading | newline_to_br }}</h3>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="apex-feature__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="apex-button apex-button--dark apex-feature__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            <span class="apex-button__label">{{ section.settings.button_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .apex-feature {
    overflow-x: clip;
  }

  /* Laid out on a 1440px stage: 1cqw = 14.4px at full size */
  .apex-feature__stage {
    position: relative;
    max-width: 1440px;
    margin-inline: auto;
    container-type: inline-size;
    isolation: isolate;
  }

  .apex-feature__title {
    position: relative;
    z-index: 2;
  }

  .apex-feature__panel {
    position: relative;
    margin-block-start: var(--apex-space-24);
  }

  .apex-feature__panel::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline: calc((100cqw - 100vw) / 2);
    background: linear-gradient(
      90deg,
      var(--apex-feature-from) 0%,
      var(--apex-feature-from) 31%,
      var(--apex-feature-to) 53%,
      transparent 100%
    );
  }

  .apex-feature__media img,
  .apex-feature__media svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .apex-feature__media--placeholder svg {
    aspect-ratio: 1127 / 940;
    fill: rgb(64 68 61 / 0.15);
  }

  .apex-feature__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--apex-burrow);
  }

  .apex-feature__eyebrow {
    margin: 0 0 var(--apex-space-24);
  }

  .apex-feature__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: var(--font-size--h1);
    line-height: 0.8;
    text-transform: uppercase;
    color: var(--apex-burrow);
  }

  .apex-feature__text {
    max-width: 347px;
    margin-block-start: var(--apex-space-24);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .apex-feature__text p {
    margin: 0;
  }

  .apex-feature__button {
    margin-block-start: var(--apex-space-48);
  }

  @media screen and (min-width: 990px) {
    .apex-feature {
      /* Room for the jars that hang below the panel */
      padding-block: 116px 0;
    }

    /* Room for the jars that hang below the panel. Set on the panel, not the stage: cqw on the
       stage itself would measure the screen, not the stage. */
    .apex-feature__panel {
      display: flex;
      align-items: center;
      min-height: 32.01cqw;
      margin-block-end: 15.6cqw;
    }

    .apex-feature__media {
      position: absolute;
      z-index: 1;
      inset-block-start: -17.71cqw;
      inset-inline-start: -1.25cqw;
      width: 78.26cqw;
      pointer-events: none;
    }

    .apex-feature__content {
      width: min(476px, 33cqw);
      padding-block: 38px 48px;
      margin-inline-start: 60.69cqw;
    }

    .apex-feature__decoration {
      inset-block-start: calc(var(--font-size--h2) * 0.95 + var(--apex-space-24) - 17.22cqw);
      inset-inline-start: 75.49cqw;
      width: 40.97cqw;
    }
  }

  @media screen and (max-width: 989px) {
    .apex-feature {
      padding-block: var(--apex-space-64) var(--apex-space-48);
    }

    .apex-feature__panel::before {
      background: linear-gradient(
        180deg,
        transparent 0%,
        var(--apex-feature-to) 45%,
        transparent 100%
      );
    }

    .apex-feature__media {
      width: min(100%, 640px);
      margin-inline: auto;
    }

    .apex-feature__content {
      padding: var(--apex-space-24) var(--page-margin, 16px) var(--apex-space-48);
    }

    .apex-feature__decoration {
      inset-block-start: 0;
      inset-inline-end: -20%;
      width: 60%;
      opacity: 0.6;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APEX feature",
  "tag": "section",
  "class": "apex-feature-section",
  "settings": [
    {
      "type": "text",
      "id": "indicator_label",
      "label": "Name in the page indicator",
      "default": "Superblend",
      "info": "Shown next to this section's dot on the left. Leave blank to leave it out."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop premium Superblend range"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image",
      "info": "Transparent PNG of the three jars together, about 2250 x 1880px (Figma layers \"APEX_Jar_Mockup-Gold 2\", \"-Green2 2\" and \"-Purple 2\" exported as one)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium animal supplements"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Superblend\ndietary supplement"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Welcome to Burger Bliss, where we take your cravings to a whole new level! Our mouthwatering burgers are made from 100% beef and are served on freshly baked buns.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop premium range"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Panel"
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Gradient start (left)",
      "default": "#40443D"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Gradient middle",
      "default": "#A0AA98",
      "info": "Fades to transparent on the right."
    },
    {
      "type": "image_picker",
      "id": "decoration",
      "label": "Line art behind the top right",
      "info": "Transparent PNG (Figma \"Snake Vector\", 590 x 588)."
    }
  ],
  "presets": [
    {
      "name": "APEX feature"
    }
  ]
}
{% endschema %}
