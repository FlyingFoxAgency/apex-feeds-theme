{% comment %}
  APEX wholesale account (Figma "APEX Wholesale Dashboard Page"). Lives on /pages/wholesale under
  the wholesale login section: signed-in approved wholesalers (customer tag set in Theme settings >
  APEX Feeds > Wholesale) see this dashboard and the login section hides itself. Everyone else
  sees the login and this section prints nothing.

  Views (one page, the side menu switches them without reloading, same script as my account):
    overview (Dashboard), quick-order, orders, order-<id> (?order=<id>), price-list, business,
    terms, wishlist.

  Changes from Figma, to fit James's terms:
  - No pricing tiers: James has one fixed wholesale price. The tier panel shows the steps that
    apply to an order instead: wholesale price (from the $250 minimum), then the bulk discounts
    for wholesale accounts only (5% off over $1,000, 10% over $5,000, ex GST; section settings).
    The progress bar is this cart against the next step.
  - Prices: wholesalers pay full price (RRP). Shopify takes off automatic "Bulk order 5% / 10% off"
    order discounts for the "Wholesale customers" segment (tag wholesale), min $1,100 / $5,500 inc
    GST = $1,000 / $5,000 ex GST. The dashboard shows prices ex and inc GST (see
    snippets/apex-wholesale-price for the optional % / metafield overrides). Carton size:
    custom.carton_qty (Integer, variant or product). See snippets/apex-wholesale-price.
  - Payment terms / credit limit come from customer metafields custom.payment_terms and
    custom.credit_limit (only set for accounts James gives credit). Business name and ABN from
    custom.business_name and custom.abn (or the default address's company).
  - Shopify gives the theme no invoices; tax invoices are the order emails, and unpaid orders link
    to Shopify's order page to pay.
  - Signed agreements: placeholder until the Cloudflare wholesale docs service is connected
    (phase 2, needs a customer account extension).
{% endcomment %}
{%- liquid
  capture is_wholesale
    render 'apex-wholesale-check'
  endcapture
  assign is_wholesale = is_wholesale | strip
-%}
{%- if is_wholesale == 'true' -%}
  {%- liquid
    assign minimum = section.settings.minimum_order | default: 250
    assign minimum_cents = minimum | times: 100
    assign contact_email = section.settings.contact_email | default: shop.email
    assign profile_url = routes.account_addresses_url
    assign order_collection = section.settings.quick_order_collection | default: collections.all
    assign business_name = customer.metafields.custom.business_name.value | default: customer.default_address.company | default: customer.name | default: customer.email
    assign payment_terms = customer.metafields.custom.payment_terms.value | default: section.settings.default_terms
    assign credit_limit = customer.metafields.custom.credit_limit.value
    assign abn = customer.metafields.custom.abn.value
    assign welcome = 'Welcome back, ' | append: business_name

    # This cart at wholesale prices (ex GST), for the minimum order bar.
    assign cart_cents = 0
    for item in cart.items
      capture wp
        render 'apex-wholesale-price', variant: item.variant
      endcapture
      assign wp = wp | strip
      if wp != ''
        assign line = wp | plus: 0 | times: item.quantity
      else
        assign line = item.final_line_price | divided_by: 1.1 | round
      endif
      assign cart_cents = cart_cents | plus: line
    endfor

    # Bulk discounts for wholesale orders (James: 5% over $1,000, 10% over $5,000, ex GST).
    assign bulk1 = section.settings.bulk_1_from | default: 0 | times: 100
    assign bulk1_pct = section.settings.bulk_1_percent | default: 0
    assign bulk2 = section.settings.bulk_2_from | default: 0 | times: 100
    assign bulk2_pct = section.settings.bulk_2_percent | default: 0
    assign bulk_on = false
    if bulk1 > 0 and bulk1_pct > 0
      assign bulk_on = true
    endif

    # Which step the cart is on, and the next goal for the bar.
    assign stage = 'minimum'
    assign goal = minimum_cents
    if cart_cents >= minimum_cents
      assign stage = 'wholesale'
      if bulk_on
        assign goal = bulk1
        if cart_cents >= bulk1
          assign stage = 'bulk1'
          assign goal = bulk2
          if bulk2 == 0 or bulk2_pct == 0 or cart_cents >= bulk2
            assign stage = 'bulk2'
            assign goal = cart_cents
            if bulk2 == 0 or bulk2_pct == 0
              assign stage = 'bulk1'
            endif
          endif
        endif
      endif
    endif
    assign cart_pct = 100
    if goal > 0 and cart_cents < goal
      assign cart_pct = cart_cents | times: 100.0 | divided_by: goal
    endif
    assign cart_short = goal | minus: cart_cents
    assign bulk_json = '[]'
    if bulk_on
      assign bulk_json = '[[' | append: bulk1 | append: ',' | append: bulk1_pct | append: ']'
      if bulk2 > 0 and bulk2_pct > 0
        assign bulk_json = bulk_json | append: ',[' | append: bulk2 | append: ',' | append: bulk2_pct | append: ']'
      endif
      assign bulk_json = bulk_json | append: ']'
    endif
  -%}

  {%- capture icon_logout -%}
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
      <path d="M8 3.5H3.5v13H8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M7.5 10h9M13.5 6.75 16.75 10l-3.25 3.25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- endcapture -%}

  {%- capture order_footer -%}
    <div class="apex-wq__footer">
      <p class="apex-wq__terms">Minimum order {{ minimum_cents | money_without_trailing_zeros }}&nbsp;&nbsp;·&nbsp;&nbsp;Prices exclude GST&nbsp;&nbsp;·&nbsp;&nbsp;Ordered in cartons</p>
      <div class="apex-wq__total">
        <p class="apex-wq__total-text">
          Order total <span data-wq-total>{{ 0 | money }}</span>
          <span class="apex-wq__discount" data-wq-discount hidden></span>
        </p>
        <button type="button" class="apex-button apex-account__button--moss" data-wq-submit disabled>Add to cart</button>
      </div>
      <p class="apex-account__small apex-wq__status" data-wq-status role="status"></p>
    </div>
  {%- endcapture -%}

  {%- capture table_head -%}
    <div class="apex-wq__row apex-wq__row--head" aria-hidden="true">
      <span>Product</span>
      <span>Inc GST</span>
      <span>Ex GST</span>
      <span>Carton</span>
      <span>Qty</span>
    </div>
  {%- endcapture -%}

  <apex-account
    class="apex-account apex-wholesale"
    style="--apex-account-pt: {{ section.settings.padding_top }}px; --apex-account-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="apex-container">
      {%- paginate customer.orders by 20 -%}
        {%- liquid
          assign views = 'overview,quick-order,orders,price-list,business,terms,wishlist' | split: ','
          assign titles = section.settings.title | append: '|Quick order|Order history|Price list|Business details|Terms and agreements|Wishlist' | split: '|'
        -%}
        {%- for view in views -%}
          <div class="apex-account__header" data-apex-view="{{ view }}"{% unless forloop.first %} hidden{% endunless %}>
            <div class="apex-account__titles">
              {%- if forloop.first -%}
                <p class="apex-eyebrow">{{ welcome | escape }}</p>
              {%- else -%}
                <p class="apex-eyebrow"><a href="?view=overview" data-apex-go="overview">{{ section.settings.title | escape }}</a></p>
              {%- endif -%}
              <h1 class="apex-account__title">{{ titles[forloop.index0] | escape }}</h1>
            </div>
            <a class="apex-account__logout" href="{{ routes.account_logout_url }}">{{ icon_logout }}<span>Log out</span></a>
          </div>
        {%- endfor -%}
        {%- for order in customer.orders -%}
          <div class="apex-account__header" data-apex-view="order-{{ order.id }}" hidden>
            <div class="apex-account__titles">
              <p class="apex-eyebrow">
                <a href="?view=overview" data-apex-go="overview">{{ section.settings.title | escape }}</a>
                <span aria-hidden="true">&nbsp;/&nbsp;</span>
                <a href="?view=orders" data-apex-go="orders">Order history</a>
              </p>
              <h1 class="apex-account__title">Order {{ order.name | escape }}</h1>
            </div>
            <a class="apex-account__logout" href="{{ routes.account_logout_url }}">{{ icon_logout }}<span>Log out</span></a>
          </div>
        {%- endfor -%}

        <div class="apex-account__body">
          <nav class="apex-account__menu" aria-label="Wholesale account">
            <ul class="apex-account__menu-list" role="list">
              <li><a class="apex-account__menu-item" href="?view=overview" data-apex-go="overview" data-apex-menu="overview">Dashboard</a></li>
              <li><a class="apex-account__menu-item" href="?view=quick-order" data-apex-go="quick-order" data-apex-menu="quick-order">Quick order</a></li>
              <li><a class="apex-account__menu-item" href="?view=orders" data-apex-go="orders" data-apex-menu="orders">Order history</a></li>
              <li><a class="apex-account__menu-item" href="?view=price-list" data-apex-go="price-list" data-apex-menu="price-list">Price list</a></li>
              <li><a class="apex-account__menu-item" href="?view=business" data-apex-go="business" data-apex-menu="business">Business details</a></li>
              <li><a class="apex-account__menu-item" href="?view=terms" data-apex-go="terms" data-apex-menu="terms">Terms and agreements</a></li>
              <li><a class="apex-account__menu-item" href="?view=wishlist" data-apex-go="wishlist" data-apex-menu="wishlist">Wishlist</a></li>
            </ul>
            <hr class="apex-account__rule">
            <a class="apex-account__menu-item apex-account__menu-logout" href="{{ routes.account_logout_url }}">{{ icon_logout }}<span>Log out</span></a>
          </nav>

          <div class="apex-account__main">
            {%- comment -%} ============ Dashboard ============ {%- endcomment -%}
            <div class="apex-account__view" data-apex-view="overview">
              {%- comment -%} Pricing panel (Figma "Pricing tier") {%- endcomment -%}
              <div class="apex-account__card apex-account__card--wide apex-account__card--dark apex-wpanel">
                <div class="apex-wpanel__top">
                  <div class="apex-wpanel__intro">
                    <p class="apex-wpanel__eyebrow">{{ section.settings.pricing_eyebrow | escape }}</p>
                    <h2 class="apex-wpanel__title">{{ section.settings.pricing_title | escape }}</h2>
                    <p class="apex-wpanel__text">{{ section.settings.pricing_text | escape }}</p>
                  </div>
                  <div class="apex-wpanel__progress">
                    <p class="apex-wpanel__eyebrow apex-wpanel__eyebrow--small">Your cart</p>
                    <div class="apex-wpanel__bar" role="progressbar" aria-label="Your cart towards the next goal" aria-valuemin="0" aria-valuemax="{{ goal | divided_by: 100 }}" aria-valuenow="{{ cart_cents | divided_by: 100 }}">
                      <span style="width: {{ cart_pct | round: 1 }}%;"></span>
                    </div>
                    <p class="apex-wpanel__amount">
                      {%- if stage == 'bulk2' -%}
                        {{ cart_cents | money }}
                      {%- else -%}
                        {{ cart_cents | money }} of {{ goal | money_without_trailing_zeros }}
                      {%- endif -%}
                    </p>
                    <p class="apex-wpanel__note">
                      {%- case stage -%}
                        {%- when 'minimum' -%}
                          {%- if cart_cents == 0 -%}
                            Your cart is empty. Orders start at {{ minimum_cents | money_without_trailing_zeros }} ex GST, before freight.
                          {%- else -%}
                            Add {{ cart_short | money }} more to reach the {{ minimum_cents | money_without_trailing_zeros }} minimum order.
                          {%- endif -%}
                        {%- when 'wholesale' -%}
                          {%- if bulk_on -%}
                            Your cart meets the minimum order. Spend {{ cart_short | money }} more to get {{ bulk1_pct }}% off this order.
                          {%- else -%}
                            Your cart meets the minimum order.
                          {%- endif -%}
                          <a href="{{ routes.cart_url }}">Go to cart</a>
                        {%- when 'bulk1' -%}
                          You're getting {{ bulk1_pct }}% off this order.
                          {%- if bulk2 > 0 and bulk2_pct > 0 %} Spend {{ cart_short | money }} more to get {{ bulk2_pct }}% off.{%- endif %}
                          <a href="{{ routes.cart_url }}">Go to cart</a>
                        {%- when 'bulk2' -%}
                          You're getting {{ bulk2_pct }}% off this order. <a href="{{ routes.cart_url }}">Go to cart</a>
                      {%- endcase -%}
                    </p>
                  </div>
                </div>
                <div class="apex-wpanel__cards">
                  <div class="apex-wpanel__card{% if stage == 'minimum' or stage == 'wholesale' %} apex-wpanel__card--current{% endif %}">
                    <p class="apex-wpanel__card-label">Standard order{% if stage == 'minimum' or stage == 'wholesale' %}&nbsp;&nbsp;·&nbsp;&nbsp;Current{% endif %}</p>
                    <p class="apex-wpanel__card-value">{% if settings.apex_wholesale_fallback_discount > 0 %}{{ settings.apex_wholesale_fallback_discount }}% off RRP{% else %}Full price{% endif %}</p>
                    <p class="apex-wpanel__card-text">Orders from {{ minimum_cents | money_without_trailing_zeros }}{% if bulk_on %} up to {{ bulk1 | money_without_trailing_zeros }}{% endif %} ex GST</p>
                  </div>
                  {%- if bulk_on -%}
                    <div class="apex-wpanel__card{% if stage == 'bulk1' %} apex-wpanel__card--current{% endif %}">
                      <p class="apex-wpanel__card-label">Bulk order{% if stage == 'bulk1' %}&nbsp;&nbsp;·&nbsp;&nbsp;Current{% endif %}</p>
                      <p class="apex-wpanel__card-value">{{ bulk1_pct }}% off the order</p>
                      <p class="apex-wpanel__card-text">Orders over {{ bulk1 | money_without_trailing_zeros }} ex GST</p>
                    </div>
                    {%- if bulk2 > 0 and bulk2_pct > 0 -%}
                      <div class="apex-wpanel__card{% if stage == 'bulk2' %} apex-wpanel__card--current{% endif %}">
                        <p class="apex-wpanel__card-label">Large order{% if stage == 'bulk2' %}&nbsp;&nbsp;·&nbsp;&nbsp;Current{% endif %}</p>
                        <p class="apex-wpanel__card-value">{{ bulk2_pct }}% off the order</p>
                        <p class="apex-wpanel__card-text">Orders over {{ bulk2 | money_without_trailing_zeros }} ex GST</p>
                      </div>
                    {%- endif -%}
                  {%- else -%}
                    <div class="apex-wpanel__card">
                      <p class="apex-wpanel__card-label">Retail</p>
                      <p class="apex-wpanel__card-value">RRP</p>
                      <p class="apex-wpanel__card-text">What your customers pay</p>
                    </div>
                  {%- endif -%}
                </div>
              </div>

              {%- comment -%}
                Quick order: the items from the last order (ready to reorder), else the first products
                of the quick order collection.
              {%- endcomment -%}
              <apex-wholesale-order class="apex-account__card apex-account__card--wide apex-wq" data-minimum="{{ minimum_cents }}" data-bulk="{{ bulk_json }}" data-in-cart="{{ cart_cents }}" data-currency="{{ cart.currency.iso_code }}">
                <div class="apex-account__card-top">
                  <h2 class="apex-account__h3">Quick order</h2>
                  <a class="apex-account__link" href="?view=price-list" data-apex-go="price-list">Download price list</a>
                </div>
                {%- if customer.last_order -%}
                  <p class="apex-account__small apex-account__muted">From your last order, {{ customer.last_order.name | escape }}. Change the quantities or <a class="apex-account__link" href="?view=quick-order" data-apex-go="quick-order">order anything else</a>.</p>
                {%- endif -%}
                <div class="apex-wq__table">
                  {{ table_head }}
                  {%- assign shown = 0 -%}
                  {%- if customer.last_order -%}
                    {%- for line_item in customer.last_order.line_items -%}
                      {%- if line_item.variant and shown < 8 -%}
                        {%- liquid
                          assign v = line_item.variant
                          assign carton = v.metafields.custom.carton_qty.value | default: v.product.metafields.custom.carton_qty.value | default: 1 | plus: 0
                          if carton < 1
                            assign carton = 1
                          endif
                          assign cartons = line_item.quantity | plus: carton | minus: 1 | divided_by: carton
                          assign shown = shown | plus: 1
                        -%}
                        {%- render 'apex-wholesale-row', variant: v, qty: cartons, key: 'dash', contact_email: contact_email -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- if shown == 0 -%}
                    {%- for product in order_collection.products limit: 5 -%}
                      {%- render 'apex-wholesale-row', variant: product.selected_or_first_available_variant, qty: 0, key: 'dash', contact_email: contact_email -%}
                    {%- endfor -%}
                  {%- endif -%}
                </div>
                {{ order_footer }}
              </apex-wholesale-order>

              {%- comment -%} New for your store (Figma "Recommended") {%- endcomment -%}
              {%- assign rec = section.settings.recommended_collection -%}
              {%- assign rec_count = section.settings.recommended_count | plus: 0 -%}
              {%- if rec != blank and rec.products_count > 0 -%}
                <div class="apex-account__card apex-account__card--wide">
                  <div class="apex-account__card-top">
                    <h2 class="apex-account__h3">{{ section.settings.recommended_heading | escape }}</h2>
                    <a class="apex-account__link" href="{{ rec.url }}">Shop at wholesale prices</a>
                  </div>
                  <div class="apex-wrec">
                    {%- for product in rec.products limit: rec_count -%}
                      {%- liquid
                        assign v = product.selected_or_first_available_variant
                        capture wp
                          render 'apex-wholesale-price', variant: v
                        endcapture
                        assign wp = wp | strip
                        assign carton = v.metafields.custom.carton_qty.value | default: product.metafields.custom.carton_qty.value | default: 1 | plus: 0
                        if carton < 1
                          assign carton = 1
                        endif
                        assign image = v.featured_media.preview_image | default: product.featured_media.preview_image
                      -%}
                      <article class="apex-wrec__item">
                        <a class="apex-wrec__image" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                          {%- if image -%}
                            {{ image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', sizes: '(min-width: 990px) 260px, 90vw', alt: '' }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag }}
                          {%- endif -%}
                          {%- if settings.apex_wholesale_fallback_discount > 0 -%}<span class="apex-account__status apex-account__status--dark apex-wrec__pill">Wholesale price</span>{%- endif -%}
                        </a>
                        <a class="apex-wrec__title" href="{{ product.url }}">{{ product.title | escape }}</a>
                        <p class="apex-wrec__price">
                          {%- if wp != '' -%}
                            <span>{{ wp | plus: 0 | money }} <span class="apex-wrec__rrp">ex GST</span></span>
                            <span class="apex-wrec__rrp">{{ wp | plus: 0 | times: 1.1 | round | money }} inc GST</span>
                          {%- else -%}
                            <span>Price on request</span>
                          {%- endif -%}
                        </p>
                        {%- if wp != '' -%}
                          <p class="apex-wrec__carton">
                            {%- if carton > 1 -%}
                              Carton of {{ carton }} units&nbsp;&nbsp;·&nbsp;&nbsp;{{ wp | plus: 0 | times: carton | money }} ex GST
                            {%- else -%}
                              Sold singly&nbsp;&nbsp;·&nbsp;&nbsp;ex GST
                            {%- endif -%}
                          </p>
                        {%- endif -%}
                        {%- if v.available and wp != '' -%}
                          <form class="apex-wrec__form" action="{{ routes.cart_add_url }}" method="post">
                            <input type="hidden" name="id" value="{{ v.id }}">
                            <input type="hidden" name="quantity" value="{{ carton }}">
                            <button type="submit" class="apex-button apex-account__button--moss apex-wrec__button">{% if carton > 1 %}Add carton{% else %}Add to cart{% endif %}</button>
                          </form>
                        {%- elsif v.available == false -%}
                          <span class="apex-button apex-account__button--outline apex-wrec__button" aria-disabled="true">Out of stock</span>
                        {%- else -%}
                          <a class="apex-button apex-account__button--outline apex-wrec__button" href="mailto:{{ contact_email }}?subject={{ 'Wholesale price: ' | append: product.title | url_encode }}">Ask us</a>
                        {%- endif -%}
                      </article>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              {%- comment -%} Recent orders + Account and terms {%- endcomment -%}
              {%- liquid
                assign unpaid_cents = 0
                assign first_unpaid = nil
                for order in customer.orders
                  if order.cancelled == false
                    if order.financial_status == 'pending' or order.financial_status == 'partially_paid' or order.financial_status == 'authorized'
                      assign unpaid_cents = unpaid_cents | plus: order.total_price
                      if first_unpaid == nil
                        assign first_unpaid = order
                      endif
                    endif
                  endif
                endfor
              -%}
              <div class="apex-account__pair">
                <div class="apex-account__card apex-account__card--side">
                  <h2 class="apex-account__h4">Recent orders</h2>
                  {%- if customer.orders_count > 0 -%}
                    <ul class="apex-wrecent" role="list">
                      {%- for order in customer.orders limit: 3 -%}
                        <li>
                          <a class="apex-wrecent__order" href="?order={{ order.id }}" data-apex-go="order-{{ order.id }}">
                            <span>
                              <span class="apex-wrecent__name">{{ order.name | escape }}</span>
                              <span class="apex-wrecent__meta">{{ order.created_at | date: '%-d %b' }}&nbsp;&nbsp;·&nbsp;&nbsp;{{ order.total_price | money }}</span>
                            </span>
                            {%- render 'apex-account-status', order: order -%}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                    <a class="apex-account__link" href="?view=orders" data-apex-go="orders">View all orders</a>
                  {%- else -%}
                    <p class="apex-account__empty">No orders yet. Your first wholesale order will show here.</p>
                    <a class="apex-account__link" href="?view=quick-order" data-apex-go="quick-order">Start a quick order</a>
                  {%- endif -%}
                </div>

                <div class="apex-account__card apex-account__card--side">
                  <h2 class="apex-account__h4">Account and terms</h2>
                  <dl class="apex-wterms">
                    <div><dt>Payment terms</dt><dd>{{ payment_terms | escape }}</dd></div>
                    {%- if credit_limit != blank -%}
                      <div><dt>Credit limit</dt><dd>{{ credit_limit | times: 100 | round | money }}</dd></div>
                    {%- endif -%}
                    <div><dt>Unpaid orders</dt><dd>{% if unpaid_cents > 0 %}{{ unpaid_cents | money }}{% else %}None{% endif %}</dd></div>
                    <div><dt>Minimum order</dt><dd>{{ minimum_cents | money_without_trailing_zeros }} ex GST</dd></div>
                    {%- if bulk_on -%}
                      <div><dt>Bulk discount</dt><dd>{{ bulk1_pct }}% over {{ bulk1 | money_without_trailing_zeros }}{% if bulk2 > 0 and bulk2_pct > 0 %}, {{ bulk2_pct }}% over {{ bulk2 | money_without_trailing_zeros }}{% endif %}</dd></div>
                    {%- endif -%}
                    <div><dt>Your contact</dt><dd><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></dd></div>
                  </dl>
                  {%- if first_unpaid -%}
                    <a class="apex-account__link" href="{{ first_unpaid.order_status_url }}">Pay {{ first_unpaid.name | escape }}</a>
                  {%- else -%}
                    <a class="apex-account__link" href="?view=terms" data-apex-go="terms">See your terms</a>
                  {%- endif -%}
                </div>
              </div>
            </div>

            {%- comment -%} ============ Quick order (everything) ============ {%- endcomment -%}
            <div class="apex-account__view" data-apex-view="quick-order" hidden>
              <apex-wholesale-order class="apex-account__card apex-account__card--wide apex-wq" data-minimum="{{ minimum_cents }}" data-bulk="{{ bulk_json }}" data-in-cart="{{ cart_cents }}" data-currency="{{ cart.currency.iso_code }}">
                <div class="apex-account__card-top">
                  <h2 class="apex-account__h3">All products</h2>
                  <a class="apex-account__link" href="?view=price-list" data-apex-go="price-list">Download price list</a>
                </div>
                <div class="apex-wq__table">
                  {{ table_head }}
                  {%- for product in order_collection.products limit: 50 -%}
                    {%- for variant in product.variants -%}
                      {%- render 'apex-wholesale-row', variant: variant, qty: 0, key: 'all', contact_email: contact_email -%}
                    {%- endfor -%}
                  {%- else -%}
                    <p class="apex-account__empty">No products to show yet.</p>
                  {%- endfor -%}
                </div>
                {{ order_footer }}
              </apex-wholesale-order>
            </div>

            {%- comment -%} ============ Order history ============ {%- endcomment -%}
            <div class="apex-account__view" data-apex-view="orders" hidden>
              <div class="apex-account__card apex-account__card--wide">
                <h2 class="apex-account__h3">Your orders</h2>
                {%- if customer.orders_count > 0 -%}
                  {%- render 'apex-account-orders-table', orders: customer.orders, limit: 20 -%}
                  {%- if paginate.pages > 1 -%}
                    <nav class="apex-account__pager" aria-label="Order pages">
                      {%- if paginate.previous -%}
                        <a class="apex-account__link" href="?view=orders&amp;page={{ paginate.current_page | minus: 1 }}">Newer orders</a>
                      {%- endif -%}
                      <span class="apex-account__small">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
                      {%- if paginate.next -%}
                        <a class="apex-account__link" href="?view=orders&amp;page={{ paginate.current_page | plus: 1 }}">Older orders</a>
                      {%- endif -%}
                    </nav>
                  {%- endif -%}
                  <p class="apex-account__small apex-account__muted">{{ section.settings.invoice_note | escape }}</p>
                {%- else -%}
                  <p class="apex-account__empty">You haven't placed any wholesale orders yet.</p>
                  <a class="apex-account__link" href="?view=quick-order" data-apex-go="quick-order">Start a quick order</a>
                {%- endif -%}
              </div>
            </div>

            {%- for order in customer.orders -%}
              <div class="apex-account__view" data-apex-view="order-{{ order.id }}" hidden>
                {%- render 'apex-account-order', order: order -%}
              </div>
            {%- endfor -%}

            {%- comment -%} ============ Price list (prints on its own) ============ {%- endcomment -%}
            <div class="apex-account__view apex-wpl" data-apex-view="price-list" hidden>
              <div class="apex-account__card apex-account__card--wide">
                <div class="apex-account__card-top">
                  <div>
                    <h2 class="apex-account__h3">Wholesale price list</h2>
                    <p class="apex-account__small apex-account__muted apex-wpl__meta">{{ shop.name | escape }}&nbsp;&nbsp;·&nbsp;&nbsp;{{ business_name | escape }}&nbsp;&nbsp;·&nbsp;&nbsp;{{ 'now' | date: '%-d %B %Y' }}</p>
                  </div>
                  <button type="button" class="apex-button apex-account__button--outline apex-wpl__print" onclick="window.print()">Print or save as PDF</button>
                </div>
                <table class="apex-wpl__table">
                  <thead>
                    <tr>
                      <th scope="col">Product</th>
                      <th scope="col">Carton</th>
                      <th scope="col" class="apex-wpl__num">RRP inc GST</th>
                      <th scope="col" class="apex-wpl__num">Your price ex GST</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- for product in order_collection.products limit: 50 -%}
                      {%- for variant in product.variants -%}
                        {%- liquid
                          capture wp
                            render 'apex-wholesale-price', variant: variant
                          endcapture
                          assign wp = wp | strip
                          assign carton = variant.metafields.custom.carton_qty.value | default: product.metafields.custom.carton_qty.value | default: 1 | plus: 0
                        -%}
                        <tr>
                          <th scope="row">
                            {{ product.title | escape }}
                            {%- unless product.has_only_default_variant -%}<span class="apex-wpl__variant">{{ variant.title | replace: ' / ', ', ' | escape }}</span>{%- endunless -%}
                          </th>
                          <td>{% if carton > 1 %}{{ carton }} units{% else %}Single{% endif %}</td>
                          <td class="apex-wpl__num">{{ variant.price | money }}</td>
                          <td class="apex-wpl__num">{% if wp != '' %}{{ wp | plus: 0 | money }}{% else %}On request{% endif %}</td>
                        </tr>
                      {%- endfor -%}
                    {%- endfor -%}
                  </tbody>
                </table>
                <p class="apex-account__small apex-account__muted">{{ section.settings.price_list_note | escape }}</p>
              </div>
            </div>

            {%- comment -%} ============ Business details ============ {%- endcomment -%}
            <div class="apex-account__view" data-apex-view="business" hidden>
              <div class="apex-account__card apex-account__card--wide">
                <div class="apex-account__card-top">
                  <h2 class="apex-account__h3">Your business</h2>
                  <a class="apex-button apex-account__button--outline" href="{{ profile_url }}">Edit contact and addresses</a>
                </div>
                <dl class="apex-account__facts">
                  <div><dt>Business name</dt><dd>{{ business_name | escape }}</dd></div>
                  {%- if abn != blank -%}
                    <div><dt>ABN</dt><dd>{{ abn | escape }}</dd></div>
                  {%- endif -%}
                  <div><dt>Contact name</dt><dd>{{ customer.name | default: 'Not added yet' | escape }}</dd></div>
                  <div><dt>Email</dt><dd>{{ customer.email | escape }}</dd></div>
                  {%- if customer.phone != blank -%}
                    <div><dt>Phone</dt><dd>{{ customer.phone | escape }}</dd></div>
                  {%- endif -%}
                  {%- if customer.default_address -%}
                    <div>
                      <dt>Delivery address</dt>
                      <dd class="apex-account__lines">{%- render 'apex-account-address-lines', address: customer.default_address, show_name: false -%}</dd>
                    </div>
                  {%- endif -%}
                </dl>
                <p class="apex-account__small apex-account__muted">
                  {{ section.settings.business_note | escape }}
                  <a class="apex-account__link" href="mailto:{{ contact_email }}?subject={{ 'Wholesale account change: ' | append: business_name | url_encode }}">Email us</a>
                </p>
              </div>
            </div>

            {%- comment -%} ============ Terms and agreements ============ {%- endcomment -%}
            <div class="apex-account__view" data-apex-view="terms" hidden>
              <div class="apex-account__card apex-account__card--wide">
                <h2 class="apex-account__h3">Your terms</h2>
                <dl class="apex-account__facts">
                  <div><dt>Payment terms</dt><dd>{{ payment_terms | escape }}</dd></div>
                  {%- if credit_limit != blank -%}
                    <div><dt>Credit limit</dt><dd>{{ credit_limit | times: 100 | round | money }}</dd></div>
                  {%- endif -%}
                  <div><dt>Minimum order</dt><dd>{{ minimum_cents | money_without_trailing_zeros }} ex GST, before freight</dd></div>
                  {%- if bulk_on -%}
                    <div><dt>Bulk discounts</dt><dd>{{ bulk1_pct }}% off orders over {{ bulk1 | money_without_trailing_zeros }}{% if bulk2 > 0 and bulk2_pct > 0 %}, {{ bulk2_pct }}% off orders over {{ bulk2 | money_without_trailing_zeros }}{% endif %} (ex GST)</dd></div>
                  {%- endif -%}
                  <div><dt>Prices</dt><dd>Exclude GST. GST is added to your invoice.</dd></div>
                </dl>
                {%- if section.settings.terms_text != blank -%}
                  <div class="apex-wterms__text">{{ section.settings.terms_text }}</div>
                {%- endif -%}
              </div>

              <div class="apex-account__card apex-account__card--wide">
                <h2 class="apex-account__h3">Agreements</h2>
                <p class="apex-account__lead">{{ section.settings.agreements_text | escape }}</p>
                <div class="apex-wterms__actions">
                  {%- if section.settings.agreement_url != blank -%}
                    <a class="apex-button apex-account__button--outline" href="{{ section.settings.agreement_url }}" target="_blank" rel="noopener">Read the Retailer Agreement</a>
                  {%- endif -%}
                  <a class="apex-account__link" href="mailto:{{ contact_email }}?subject={{ 'Copy of my signed agreement: ' | append: business_name | url_encode }}">Request a copy</a>
                </div>
              </div>
            </div>

            {%- comment -%} ============ Wishlist (same list as my account, saved in this browser) ============ {%- endcomment -%}
            <div class="apex-account__view" data-apex-view="wishlist" hidden>
              <apex-wishlist-list class="apex-account__card apex-account__card--wide apex-wishlist">
                <div class="apex-account__card-top">
                  <div class="apex-wishlist__intro">
                    <h2 class="apex-account__h3">Saved items (<span data-wishlist-count>0</span>)</h2>
                    <p class="apex-account__small apex-account__muted">{{ section.settings.wishlist_text | escape }}</p>
                  </div>
                  <button type="button" class="apex-button apex-account__button--outline" data-wishlist-add-all hidden>Add all to cart</button>
                </div>
                <p class="apex-account__small" data-wishlist-status role="status"></p>
                <div class="apex-wishlist__grid" data-wishlist-grid hidden></div>
                <div class="apex-wishlist__empty" data-wishlist-empty>
                  <p class="apex-account__empty">{{ section.settings.wishlist_empty | escape }}</p>
                  <a class="apex-account__link" href="?view=quick-order" data-apex-go="quick-order">Go to quick order</a>
                </div>
              </apex-wishlist-list>
            </div>
          </div>
        </div>
      {%- endpaginate -%}
    </div>
  </apex-account>
{%- endif -%}

{% stylesheet %}
  /* Wholesale dashboard: builds on the .apex-account styles (sections/apex-account.liquid) */

  /* Pricing panel (Figma "Pricing tier": burrow card, sandstone text) */
  .apex-wpanel {
    gap: 32px;
  }

  .apex-wpanel__top {
    display: grid;
    grid-template-columns: minmax(0, 432px) minmax(0, 340px);
    justify-content: space-between;
    gap: 48px;
    width: 100%;
  }

  .apex-wpanel__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1rem;
    text-transform: uppercase;
    color: var(--apex-sandstone);
  }

  .apex-wpanel__eyebrow--small {
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 0.875rem;
    letter-spacing: 0.5px;
  }

  .apex-wpanel__title {
    margin: 12px 0 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 4rem;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--apex-sandstone);
  }

  .apex-wpanel__text {
    margin: 12px 0 0;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .apex-wpanel__bar {
    height: 8px;
    margin-top: 12px;
    overflow: hidden;
    border-radius: var(--apex-radius-pill);
    background: var(--apex-onyx);
  }

  .apex-wpanel__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--apex-amber);
  }

  .apex-wpanel__amount {
    margin: 12px 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-wpanel__note {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .apex-wpanel__note a {
    color: inherit;
    font-weight: 700;
  }

  .apex-wpanel__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
  }

  .apex-wpanel__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px;
    border: 1px solid var(--apex-dried-moss);
    border-radius: var(--apex-radius-md);
  }

  .apex-wpanel__card p {
    margin: 0;
  }

  .apex-wpanel__card-label {
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 0.875rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .apex-wpanel__card-value {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-wpanel__card-text {
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .apex-wpanel__card--current {
    border-color: var(--apex-amber);
    background: var(--apex-amber);
    color: var(--apex-stone-100);
  }

  /* Quick order table (Figma columns 300 / 90 / 100 / 90 / 120, 24px gaps) */
  .apex-wq__table {
    width: 100%;
  }

  .apex-wq__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 90px 100px 90px 120px;
    gap: 24px;
    align-items: center;
    padding-block: 12px;
    min-height: 68px;
    border-block-end: 1px solid var(--apex-border-grey);
  }

  .apex-wq__row--head {
    min-height: 0;
    padding-block: 16px;
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 0.875rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--apex-dried-moss);
  }

  .apex-wq__product {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .apex-wq__title {
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.25rem;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--apex-olive) !important;
  }

  .apex-wq__variant,
  .apex-wq__carton,
  .apex-wq__rrp {
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .apex-wq__variant,
  .apex-wq__rrp,
  .apex-wq__muted {
    color: var(--apex-dried-moss);
  }

  .apex-wq__price {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-wq__label {
    display: none;
  }

  .apex-wq__stepper {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 36px;
    align-items: center;
    width: 120px;
    height: 42px;
    border: 1px solid var(--apex-dried-moss);
    border-radius: var(--apex-radius-sm);
    background: var(--apex-bg-page, #fff);
  }

  .apex-wq__step {
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 1rem;
    color: var(--apex-burrow);
    cursor: pointer;
  }

  .apex-wq__input {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.9375rem;
    text-align: center;
    color: var(--apex-burrow);
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .apex-wq__input::-webkit-outer-spin-button,
  .apex-wq__input::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .apex-wq__input:focus {
    outline: none;
  }

  .apex-wq__stepper:focus-within {
    border-color: var(--apex-burrow);
  }

  .apex-wq__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    width: 100%;
    padding-top: 16px;
  }

  .apex-wq__terms {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--apex-dried-moss);
  }

  .apex-wq__total {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .apex-wq__total-text {
    margin: 0;
    text-align: right;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
    white-space: nowrap;
  }

  .apex-wq__total-text span {
    margin-left: 6px;
  }

  .apex-wq__discount {
    display: block;
    margin: 0 !important;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.25rem;
    text-align: right;
    color: var(--apex-olive);
  }

  .apex-wq__status {
    flex-basis: 100%;
    text-align: right;
  }

  .apex-wq__status:empty {
    display: none;
  }

  .apex-wq [data-wq-submit]:disabled {
    opacity: 0.6;
    cursor: default;
    scale: none;
  }

  /* New for your store */
  .apex-wrec {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    margin-top: 16px;
  }

  .apex-wrec__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .apex-wrec__image {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 220px;
    padding: 25px;
    border-radius: var(--apex-radius-lg);
    background: var(--apex-bg-page, #fff);
  }

  .apex-wrec__image img,
  .apex-wrec__image svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .apex-wrec__pill {
    position: absolute;
    top: 12px;
    left: 12px;
  }

  .apex-wrec__title {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25rem;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--apex-olive) !important;
  }

  .apex-wrec__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-wrec__rrp {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--apex-dried-moss);
  }

  .apex-wrec__carton {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--apex-dried-moss);
  }

  .apex-wrec__form,
  .apex-wrec__button {
    width: 100%;
    margin-top: auto;
  }

  /* Recent orders */
  .apex-wrecent {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apex-wrecent__order {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    text-decoration: none;
  }

  .apex-wrecent__order > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .apex-wrecent__name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-wrecent__order:hover .apex-wrecent__name {
    color: var(--apex-olive);
  }

  .apex-wrecent__meta {
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--apex-dried-moss);
  }

  /* Account and terms list */
  .apex-wterms {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    margin: 0;
  }

  .apex-wterms div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .apex-wterms dt {
    color: var(--apex-dried-moss);
  }

  .apex-wterms dd {
    margin: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .apex-wterms__text {
    font-size: 0.9375rem;
    line-height: 1.5rem;
  }

  .apex-wterms__text > * {
    margin: 0 0 12px;
  }

  .apex-wterms__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  /* Price list */
  .apex-wpl__meta {
    margin-top: 8px;
  }

  .apex-wpl__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .apex-wpl__table th,
  .apex-wpl__table td {
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--apex-border-grey);
    text-align: left;
    vertical-align: top;
    font-weight: 400;
  }

  .apex-wpl__table thead th {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--apex-dried-moss);
  }

  .apex-wpl__table tbody th {
    font-weight: 600;
  }

  .apex-wpl__variant {
    display: block;
    font-weight: 400;
    color: var(--apex-dried-moss);
  }

  .apex-wpl__table .apex-wpl__num {
    padding-right: 0;
    text-align: right;
    white-space: nowrap;
  }

  /* Print the price list on its own */
  @media print {
    body:has(.apex-wpl:not([hidden])) * {
      visibility: hidden;
    }

    body:has(.apex-wpl:not([hidden])) .apex-wpl,
    body:has(.apex-wpl:not([hidden])) .apex-wpl * {
      visibility: visible;
    }

    .apex-wpl {
      position: absolute;
      inset: 0 auto auto 0;
      width: 100%;
    }

    .apex-wpl .apex-account__card {
      padding: 0;
      background: none;
    }

    .apex-wpl__print {
      display: none !important;
    }

    .apex-wpl__table tr {
      break-inside: avoid;
    }
  }

  @media screen and (max-width: 1199px) {
    .apex-wpanel__top {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .apex-wpanel__progress {
      max-width: 420px;
    }
  }

  @media screen and (max-width: 989px) {
    .apex-wq__row {
      grid-template-columns: minmax(0, 1fr) 70px 80px 120px;
    }

    .apex-wq__carton,
    .apex-wq__row--head span:nth-child(4) {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .apex-wpanel__title {
      font-size: 3rem;
    }

    .apex-wpanel__cards,
    .apex-wrec {
      grid-template-columns: minmax(0, 1fr);
    }

    .apex-wrec {
      gap: 40px;
    }

    /* Quick order rows: product on top, then price / RRP / carton on the left, stepper on the right */
    .apex-wq__row--head {
      display: none;
    }

    .apex-wq__row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'product product'
        'price qty'
        'rrp qty'
        'carton qty';
      gap: 2px 16px;
      padding-block: 16px;
    }

    .apex-wq__product { grid-area: product; margin-bottom: 8px; }
    .apex-wq__price { grid-area: price; }
    .apex-wq__rrp { grid-area: rrp; }
    .apex-wq__qty { grid-area: qty; align-self: center; }

    .apex-wq__carton {
      display: block;
      grid-area: carton;
      color: var(--apex-dried-moss);
    }

    .apex-wq__rrp .apex-wq__label,
    .apex-wq__carton .apex-wq__label {
      display: inline;
      margin-right: 4px;
    }

    .apex-wq__footer,
    .apex-wq__total {
      flex-direction: column;
      align-items: stretch;
    }

    .apex-wq__total .apex-button {
      width: 100%;
    }

    .apex-wq__status {
      text-align: left;
    }

    .apex-wpl__table thead th:nth-child(2),
    .apex-wpl__table tbody td:nth-child(2) {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('apex-wholesale-order')) {
    class ApexWholesaleOrder extends HTMLElement {
      connectedCallback() {
        this.minimum = Number(this.dataset.minimum || 0);
        this.inCart = Number(this.dataset.inCart || 0);
        try {
          this.bulk = JSON.parse(this.dataset.bulk || '[]').sort((a, b) => a[0] - b[0]);
        } catch (e) {
          this.bulk = [];
        }
        this.money = new Intl.NumberFormat('en-AU', { style: 'currency', currency: this.dataset.currency || 'AUD' });
        this.submit = this.querySelector('[data-wq-submit]');
        this.status = this.querySelector('[data-wq-status]');
        this.addEventListener('click', (event) => {
          const step = event.target.closest('[data-wq-step]');
          if (step) {
            const input = step.closest('[data-wq-row]').querySelector('[data-wq-input]');
            input.value = Math.max(0, Math.min(999, (parseInt(input.value, 10) || 0) + Number(step.dataset.wqStep)));
            this.update();
          }
          if (event.target.closest('[data-wq-submit]')) this.addToCart();
        });
        this.addEventListener('input', () => this.update());
        this.update();
      }

      lines() {
        return [...this.querySelectorAll('[data-wq-row]')]
          .map((row) => {
            const input = row.querySelector('[data-wq-input]');
            const cartons = input ? Math.max(0, parseInt(input.value, 10) || 0) : 0;
            const carton = Number(row.dataset.carton) || 1;
            return { id: Number(row.dataset.variant), cartons, quantity: cartons * carton, price: Number(row.dataset.price) || 0 };
          })
          .filter((line) => line.quantity > 0);
      }

      update() {
        const lines = this.lines();
        const total = lines.reduce((sum, line) => sum + line.price * line.quantity, 0);
        // Bulk discount: counted on everything in the cart once these are added (ex GST).
        const combined = total + this.inCart;
        const tier = lines.length ? this.bulk.filter(([from]) => combined >= from).pop() : null;
        const next = this.bulk.find(([from]) => combined < from);
        const percent = tier ? tier[1] : 0;
        const totalEl = this.querySelector('[data-wq-total]');
        if (totalEl) totalEl.textContent = this.money.format((total * (100 - percent)) / 100 / 100);
        const discountEl = this.querySelector('[data-wq-discount]');
        if (discountEl) {
          discountEl.hidden = !percent;
          discountEl.textContent = percent ? `Includes ${percent}% bulk discount (was ${this.money.format(total / 100)})` : '';
        }
        if (this.submit) this.submit.disabled = lines.length === 0;
        if (this.status && !this.busy) {
          let message = '';
          if (lines.length && combined < this.minimum) {
            message = `Add ${this.money.format((this.minimum - combined) / 100)} more to reach the minimum order.`;
          } else if (lines.length && next) {
            message = `Spend ${this.money.format((next[0] - combined) / 100)} more to get ${next[1]}% off the order.`;
          }
          if (message && this.inCart) message += ' Items already in your cart count too.';
          this.status.textContent = message;
        }
      }

      async addToCart() {
        const items = this.lines().map(({ id, quantity }) => ({ id, quantity }));
        if (!items.length) return;
        this.busy = true;
        this.submit.disabled = true;
        if (this.status) this.status.textContent = 'Adding to your cart…';
        try {
          const root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
          const res = await fetch(`${root}cart/add.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ items }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.description || data.message || 'Some items could not be added.');
          }
          window.location.href = `${root}cart`;
        } catch (error) {
          this.busy = false;
          this.submit.disabled = false;
          if (this.status) this.status.textContent = error.message;
        }
      }
    }
    customElements.define('apex-wholesale-order', ApexWholesaleOrder);
  }
{% endjavascript %}

