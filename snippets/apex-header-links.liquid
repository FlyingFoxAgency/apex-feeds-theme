{% doc %}
  Secondary header links on the right of the APEX header (Wholesale, Stockists).
  Burrow like the main menu, amber for the current page. Shown on desktop only. The same links are added to the mobile menu drawer.

  @param {object} linklist - The menu to render

  @example
  {% render 'apex-header-links', linklist: section.settings.apex_secondary_menu %}
{% enddoc %}
{%- if linklist != blank and linklist.links.size > 0 -%}
  <nav class="apex-header-links" aria-label="{{ linklist.title | escape }}">
    <ul class="apex-header-links__list list-unstyled" role="list">
      {%- for link in linklist.links -%}
        <li>
          <a
            href="{{ link.url }}"
            class="apex-header-links__link"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{%- endif -%}
