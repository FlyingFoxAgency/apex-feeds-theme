{% doc %}
  My account > Subscriptions (Figma "APEX Account Subscriptions Page").
  - Savings banner: what the customer saved with Subscribe and Save this year, worked out from
    their recent orders (subscription lines' full price minus what they paid), plus the offer.
  - "Your subscriptions": loaded in the browser from Appstle's customer portal API
    (assets/apex-subscriptions.js). Each one shows product, status, frequency, next delivery and
    price, with Skip next delivery, Change frequency, Pause / Resume and Cancel.
    Until Appstle is installed (or with no subscriptions) the card shows an empty state.
  - Upsell card linking to the subscribable products.

  @param {object} config - The apex-account section settings
  @param {object} orders - customer.orders (inside paginate)
{% enddoc %}
{%- liquid
  assign this_year = 'now' | date: '%Y'
  assign saved = 0
  for order in orders
    assign order_year = order.created_at | date: '%Y'
    if order_year == this_year
      for line_item in order.line_items
        assign allocation = line_item.selling_plan_allocation
        if allocation and allocation.compare_at_price > allocation.price
          assign diff = allocation.compare_at_price | minus: allocation.price | times: line_item.quantity
          assign saved = saved | plus: diff
        endif
      endfor
    endif
  endfor
  assign subscribe_page = config.subscribe_page | default: '/pages/subscribe-and-save'
  assign subscribable_url = config.subscribable_url | default: routes.all_products_collection_url
-%}
<div class="apex-subs__savings">
  <div class="apex-subs__savings-text">
    {%- if saved > 0 -%}
      <p class="apex-subs__savings-title">You have saved {{ saved | money }} with Subscribe and Save this year</p>
    {%- else -%}
      <p class="apex-subs__savings-title">Subscribe and Save</p>
    {%- endif -%}
    <p class="apex-account__small apex-account__muted">{{ config.savings_text | escape }}</p>
  </div>
  <a class="apex-account__link" href="{{ subscribe_page }}">How it works</a>
</div>

<apex-subscriptions
  class="apex-account__card apex-account__card--wide apex-subs"
  data-customer-id="{{ customer.id }}"
  data-api="{{ config.subscriptions_api | default: '/apps/subscriptions/cp/api' | escape }}"
  data-frequencies="{{ config.subscriptions_frequencies | default: '1' | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
  <div class="apex-account__card-top">
    <h2 class="apex-account__h3">Your subscriptions<span data-subs-count></span></h2>
    <a class="apex-button apex-account__button--outline" href="{{ subscribable_url }}">Add a product</a>
  </div>

  <div class="apex-subs__list" data-subs-list aria-live="polite">
    <p class="apex-account__small apex-account__muted" data-subs-loading>Loading your subscriptions…</p>
  </div>

  <div class="apex-subs__empty" data-subs-empty hidden>
    <p class="apex-account__empty">You don't have any subscriptions yet. Subscribe on a product page to save 10% on every delivery.</p>
    <a class="apex-account__link" href="{{ subscribe_page }}">How Subscribe and Save works</a>
  </div>

  <div class="apex-subs__error" data-subs-error hidden>
    <p class="apex-account__empty">We couldn't load your subscriptions just now. Please try again in a minute.</p>
  </div>

  <p class="apex-account__small apex-account__muted apex-subs__portal" data-subs-portal hidden>
    Need to change the card or delivery address for a subscription?
    <a href="{{ config.subscriptions_portal | default: '/apps/subscriptions' | escape }}">Open the subscription portal</a>
  </p>

  {%- comment -%} One subscription row; the script clones and fills it {%- endcomment -%}
  <template data-subs-template>
    <div class="apex-subs__item">
      <div class="apex-subs__image"><img alt="" loading="lazy" width="120" height="120" data-subs-img hidden></div>
      <div class="apex-subs__info">
        <div class="apex-subs__name">
          <span class="apex-subs__title" data-subs-title></span>
          <span class="apex-account__status" data-subs-status></span>
        </div>
        <p class="apex-subs__options" data-subs-options></p>
        <div class="apex-subs__meta">
          <div>
            <span class="apex-subs__label">Frequency</span>
            <span class="apex-subs__value" data-subs-frequency></span>
          </div>
          <div>
            <span class="apex-subs__label">Next</span>
            <span class="apex-subs__value" data-subs-next></span>
          </div>
        </div>
        <div class="apex-subs__actions" data-subs-actions>
          <button type="button" data-subs-action="skip">Skip next delivery</button>
          <button type="button" data-subs-action="frequency">Change frequency</button>
          <button type="button" data-subs-action="pause">Pause</button>
          <button type="button" data-subs-action="resume">Resume now</button>
          <button type="button" data-subs-action="cancel">Cancel</button>
        </div>
        <div class="apex-subs__panel" data-subs-panel hidden></div>
        <p class="apex-subs__message" data-subs-message role="status"></p>
      </div>
      <div class="apex-subs__price">
        <span class="apex-subs__now" data-subs-price></span>
        <s class="apex-subs__was" data-subs-was></s>
        <span class="apex-subs__per" data-subs-per></span>
      </div>
    </div>
  </template>
</apex-subscriptions>

<div class="apex-account__card apex-subs__upsell">
  <div class="apex-subs__upsell-text">
    <p class="apex-subs__upsell-eyebrow">{{ config.upsell_eyebrow | escape }}</p>
    <h2 class="apex-account__h4">{{ config.upsell_heading | escape }}</h2>
    <p class="apex-subs__upsell-copy">{{ config.upsell_text | escape }}</p>
  </div>
  <a class="apex-button apex-account__button--moss" href="{{ subscribable_url }}">Browse subscribable products</a>
</div>

<script src="{{ 'apex-subscriptions.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* Savings banner: stone-200 panel, 16px corners */
  .apex-subs__savings {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 32px;
    border-radius: var(--apex-radius-lg);
    background: var(--apex-stone-200);
  }

  .apex-subs__savings-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .apex-subs__savings-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-subs__list {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-block-start: 1px solid var(--apex-border-grey);
  }

  .apex-subs__list:empty {
    display: none;
  }

  .apex-subs__item {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: start;
    padding-block: 32px;
    border-block-end: 1px solid var(--apex-border-grey);
  }

  .apex-subs__item:last-child {
    border-block-end: 0;
    padding-block-end: 0;
  }

  .apex-subs__item.is-busy {
    opacity: 0.6;
    pointer-events: none;
  }

  .apex-subs__image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    overflow: hidden;
    border-radius: var(--apex-radius-lg);
    background: var(--apex-bg-page, #fff);
  }

  .apex-subs__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .apex-subs__info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .apex-subs__name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .apex-subs__title {
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25rem;
    text-transform: uppercase;
    color: var(--apex-olive);
  }

  .apex-subs__options {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--apex-dried-moss);
  }

  .apex-subs__options:empty {
    display: none;
  }

  .apex-subs__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-top: 8px;
  }

  .apex-subs__meta > div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .apex-subs__label {
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 0.875rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--apex-dried-moss);
  }

  .apex-subs__value {
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .apex-subs__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding-top: 8px;
  }

  .apex-subs__actions button,
  .apex-subs__panel button.apex-subs__plain {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    text-decoration: underline;
    color: var(--apex-burrow);
    cursor: pointer;
  }

  .apex-subs__panel {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 8px;
    padding: 16px 20px;
    border-radius: var(--apex-radius-lg);
    background: var(--apex-bg-page, #fff);
    font-size: 0.8125rem;
    line-height: 1.25rem;
  }

  .apex-subs__panel[hidden] {
    display: none;
  }

  .apex-subs__panel p {
    margin: 0;
    flex-basis: 100%;
  }

  .apex-subs__panel select {
    min-height: 40px;
    padding: 8px 12px;
    border: 1px solid var(--apex-dried-moss);
    border-radius: 4px;
    background: transparent;
    font: inherit;
    color: var(--apex-burrow);
  }

  .apex-subs__panel .apex-button {
    min-height: 40px;
    padding: 8px 16px;
    font-size: 0.8125rem;
  }

  .apex-subs__message {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--apex-olive);
  }

  .apex-subs__message:empty {
    display: none;
  }

  .apex-subs__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    white-space: nowrap;
  }

  .apex-subs__now {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
  }

  .apex-subs__was {
    font-size: 0.8125rem;
    line-height: 1.25rem;
    color: var(--apex-dried-moss);
  }

  .apex-subs__was:empty {
    display: none;
  }

  .apex-subs__per {
    font-size: 0.625rem;
    line-height: 0.875rem;
    letter-spacing: 0.5px;
    color: var(--apex-dried-moss);
  }

  .apex-subs__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .apex-subs__portal a {
    color: var(--apex-olive);
  }

  /* Upsell: burrow panel, sandstone text, button on the right */
  .apex-account__card.apex-subs__upsell {
    flex-direction: row;
    align-items: center;
    gap: 48px;
    padding: 48px;
    background: var(--apex-burrow);
    color: var(--apex-sandstone);
  }

  .apex-subs__upsell-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .apex-subs__upsell-eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1rem;
    text-transform: uppercase;
  }

  .apex-subs__upsell-copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  @media screen and (max-width: 749px) {
    .apex-subs__savings {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 20px 24px;
    }

    .apex-subs__item {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: 16px;
      padding-block: 24px;
    }

    .apex-subs__image {
      width: 80px;
      height: 80px;
    }

    /* Price moves under the details, left aligned */
    .apex-subs__price {
      grid-column: 2;
      grid-row: 2;
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 4px 8px;
    }

    .apex-subs__info {
      grid-column: 2;
      grid-row: 1;
    }

    .apex-subs__image {
      grid-row: 1 / span 2;
    }

    .apex-account__card.apex-subs__upsell {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 24px;
    }
  }
{% endstylesheet %}
