{% comment %}
  Prints "true" when a product can't be bought by this shopper and is enquiry-only (James,
  19 Nov 2026): frozen products (custom.food_type "Frozen") or products tagged "enquiry-only",
  for everyone except signed-in wholesalers. Frozen stock is mainly for wholesale; retail
  customers enquire for bulk pricing and no single frozen items are shipped.
  @param {object} product
  Use: {%- capture enquiry_only -%}{%- render 'apex-enquiry-only', product: product -%}{%- endcapture -%}
{% endcomment %}
{%- liquid
  assign food_type = product.metafields.custom.food_type.value | join: ',' | downcase
  assign is_enquiry = false
  if settings.apex_enquiry_frozen and food_type contains 'frozen'
    assign is_enquiry = true
  endif
  if product.tags contains 'enquiry-only'
    assign is_enquiry = true
  endif
  if is_enquiry
    capture apex_ws
      render 'apex-wholesale-check'
    endcapture
    unless apex_ws contains 'true'
      echo 'true'
    endunless
  endif
-%}
