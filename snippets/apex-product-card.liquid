{% doc %}
  APEX product card (Figma best seller card): glass card with a white image area, a rating pill,
  then category, title, price and a short note.

  The category is the product type. The note lists the animals the product suits, from the
  product metafield custom.suitable_for (a list of single line text, e.g. Reptiles, Amphibians),
  as "For reptiles + amphibians." If that's empty, the free text metafield custom.card_note is
  used instead. The rating uses the standard reviews.rating
  metafield that review apps fill in, and is hidden without one.

  With show_buttons (the category page): an Add to cart button under the text, and on hover the
  card grows slightly, darkens and shows a Quick add button over the image (Figma "APEX Category
  Page"). Products with one variant go straight into the cart; products with options open their
  product page to choose one.

  @param {object} product - The product to show
  @param {string} [sizes] - The image sizes attribute
  @param {boolean} [show_buttons] - Show Add to cart and the hover Quick add

  @example
  {% render 'apex-product-card', product: product %}
{% enddoc %}
{%- liquid
  assign rating = product.metafields.reviews.rating.value.rating
  assign note = product.metafields.custom.card_note.value
  assign animals = product.metafields.custom.suitable_for.value
  if animals != blank
    assign note = 'For '
    for animal in animals
      if forloop.first == false
        if forloop.last
          assign note = note | append: ' + '
        else
          assign note = note | append: ', '
        endif
      endif
      assign animal_name = animal | downcase
      assign note = note | append: animal_name
    endfor
    assign note = note | append: '.'
  endif
  assign image = product.featured_media.preview_image
  assign single_variant = false
  if product.has_only_default_variant or product.variants.size == 1
    assign single_variant = true
  endif
-%}
<article class="apex-product-card{% if show_buttons %} apex-product-card--buttons{% endif %}">
  <a class="apex-product-card__link" href="{{ product.url }}">
    <div class="apex-product-card__media">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 640
          | image_tag:
            loading: 'lazy',
            sizes: sizes | default: '(min-width: 990px) 300px, 70vw',
            widths: '300, 450, 640',
            alt: image.alt | default: product.title
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'apex-product-card__placeholder' }}
      {%- endif -%}

      {%- if rating != blank -%}
        <span class="apex-product-card__rating">
          <span class="apex-product-card__star" aria-hidden="true">{{ 'apex-icon-star.svg' | inline_asset_content }}</span>
          <span class="visually-hidden">Rated</span>
          {{ rating | round: 1 }}
          <span class="visually-hidden">out of 5</span>
        </span>
      {%- endif -%}
    </div>

    <div class="apex-product-card__info">
      {%- if product.type != blank -%}
        <p class="apex-product-card__category">{{ product.type | escape }}</p>
      {%- endif -%}
      <div class="apex-product-card__row">
        <h3 class="apex-product-card__title">{{ product.title | escape }}</h3>
        <p class="apex-product-card__price">
          {%- if product.price_varies -%}
            <span class="visually-hidden">From</span>
          {%- endif -%}
          {{ product.price | money }}
        </p>
      </div>
      {%- if note != blank -%}
        <p class="apex-product-card__note">{{ note | escape }}</p>
      {%- endif -%}
    </div>
  </a>

  {%- if show_buttons -%}
    {%- liquid
      if product.available == false
        assign cart_label = 'Sold out'
      elsif single_variant
        assign cart_label = 'Add to cart'
      else
        assign cart_label = 'Choose options'
      endif
    -%}
    <div class="apex-product-card__actions">
      {%- if product.available and single_variant -%}
        <form class="apex-product-card__form" action="{{ routes.cart_add_url }}" method="post">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="apex-product-card__cart">{{ cart_label }}</button>
        </form>
      {%- elsif product.available -%}
        <a class="apex-product-card__cart" href="{{ product.url }}">{{ cart_label }}</a>
      {%- else -%}
        <span class="apex-product-card__cart apex-product-card__cart--disabled">{{ cart_label }}</span>
      {%- endif -%}
    </div>

    {%- if product.available -%}
      <div class="apex-product-card__hover" aria-hidden="true">
        {%- if single_variant -%}
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="apex-product-card__quick" tabindex="-1">
              {{- 'apex-icon-bag.svg' | inline_asset_content -}}
              Quick add
            </button>
          </form>
        {%- else -%}
          <a class="apex-product-card__quick" href="{{ product.url }}" tabindex="-1">
            {{- 'apex-icon-bag.svg' | inline_asset_content -}}
            Quick add
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</article>

{% stylesheet %}
  .apex-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--apex-radius-lg);
    background-color: var(--apex-glass-bg);
    -webkit-backdrop-filter: blur(var(--apex-glass-blur));
    backdrop-filter: blur(var(--apex-glass-blur));
  }

  .apex-product-card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    color: var(--apex-olive);
    text-decoration: none;
  }

  .apex-product-card__media {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    aspect-ratio: 288 / 245;
    padding: var(--apex-space-12) var(--apex-space-12) 0;
    border-radius: 15px 15px 0 0;
    background-color: var(--apex-bg-page);
  }

  .apex-product-card__media img {
    width: 82%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transition: scale 0.3s var(--ease-out-cubic, ease-out);
  }

  .apex-product-card__link:is(:hover, :focus-visible) .apex-product-card__media img {
    scale: 1.06;
  }

  .apex-product-card__placeholder {
    width: 80%;
    height: 100%;
    fill: var(--apex-stone-200);
  }

  .apex-product-card__rating {
    position: absolute;
    inset-block-start: 26px;
    inset-inline-end: 22px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    height: 22px;
    padding-inline: 7px;
    border-radius: var(--apex-radius-pill);
    background-color: var(--apex-stone-200);
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--apex-olive);
  }

  .apex-product-card__star svg {
    display: block;
    width: 15px;
    height: 15px;
  }

  .apex-product-card__info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 25px 21px 21px;
  }

  .apex-product-card__category,
  .apex-product-card__note {
    margin: 0;
    font-size: 0.625rem;
    line-height: 0.875rem;
    letter-spacing: 0.5px;
  }

  .apex-product-card__category {
    font-weight: 600;
    text-transform: uppercase;
  }

  .apex-product-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--apex-space-12);
    margin-block-start: var(--apex-space-8);
  }

  .apex-product-card__title {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25rem;
    text-transform: uppercase;
    color: var(--apex-olive);
  }

  .apex-product-card__price {
    margin: 0;
    flex: none;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .apex-product-card__note {
    margin-block-start: auto;
    padding-block-start: var(--apex-space-24);
  }

  /* Category page buttons (Figma: 243 x 30 burrow pill, sandstone label; amber on hover) */
  .apex-product-card__actions {
    position: relative;
    z-index: 2;
    padding: 0 21px 21px;
  }

  .apex-product-card--buttons .apex-product-card__note {
    padding-block-start: var(--apex-space-8);
  }

  .apex-product-card--buttons .apex-product-card__info {
    padding-block-end: var(--apex-space-16);
  }

  .apex-product-card__form {
    margin: 0;
  }

  .apex-product-card__cart {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 30px;
    padding: 3px var(--apex-space-16);
    border: 0;
    border-radius: var(--apex-radius-pill);
    background-color: var(--apex-burrow);
    color: var(--apex-sandstone);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5rem;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      scale 0.2s var(--ease-out-cubic, ease-out);
  }

  .apex-product-card__cart--disabled {
    opacity: 0.5;
    cursor: default;
  }

  .apex-product-card__cart:not(.apex-product-card__cart--disabled):is(:hover, :focus-visible) {
    scale: 1.06;
  }

  /* Hover (pointer devices): the card grows a little, darkens, its button turns amber and Quick
     add appears over the image */
  .apex-product-card--buttons {
    transition: scale 0.3s var(--ease-out-cubic, ease-out);
  }

  .apex-product-card--buttons::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
    background-color: rgb(64 68 61 / 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .apex-product-card__hover {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    inset-block-start: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 288 / 245;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .apex-product-card__hover form {
    margin: 0;
  }

  .apex-product-card__quick {
    display: inline-flex;
    align-items: center;
    gap: var(--apex-space-8);
    min-height: 48px;
    padding: var(--apex-space-12) var(--apex-space-20);
    border: 0;
    border-radius: var(--apex-radius-pill);
    background-color: var(--apex-burrow);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.15);
    color: var(--apex-sandstone);
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.5rem;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: scale 0.2s var(--ease-out-cubic, ease-out);
  }

  .apex-product-card__quick svg {
    width: 20px;
    height: 20px;
  }

  .apex-product-card__quick:is(:hover, :focus-visible) {
    scale: 1.06;
  }

  @media (hover: hover) {
    .apex-product-card--buttons:hover {
      scale: 1.05;
      z-index: 1;
    }

    .apex-product-card--buttons:hover::after,
    .apex-product-card--buttons:hover .apex-product-card__hover {
      opacity: 1;
    }

    .apex-product-card--buttons:hover .apex-product-card__hover {
      pointer-events: auto;
    }

    .apex-product-card--buttons:hover .apex-product-card__cart:not(.apex-product-card__cart--disabled) {
      background-color: var(--apex-amber);
      color: var(--apex-burrow);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-product-card__media img,
    .apex-product-card--buttons,
    .apex-product-card__cart,
    .apex-product-card__quick {
      transition: none;
    }
  }
{% endstylesheet %}
